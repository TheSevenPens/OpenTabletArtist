<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless UI smoke tests (#741), kept in their own project so the fast logic suite stays fast and
    free of an Avalonia application lifetime. These render real views into a headless surface, which is
    the only place a reflection binding or a missing resource actually fails - the app disables compiled
    bindings globally, so those errors exist only at runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenTabletArtist.UiTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12.x is built on xunit v3, which is why this project moved there first.
         The logic suite followed (#756), so both now sit on one major and share one runner.

         This package is also what pins the major: it is compiled against xunit.v3.extensibility.core
         3.2.2, and 4.x changed TestIntrospectionHelper.GetTestCaseDetails. Its NuGet dependency is a
         floor, not a pin, so restore will happily resolve 4.x and every test then fails at discovery
         with MissingMethodException - a build that warns about nothing. Do not bump past 3.x until
         Avalonia ships a headless package built against xunit.v3 4.x.

         That bump also closes #935: 3.2.2 prints a shutdown message onto the stdout the VSTest
         adapter parses as JSON when asking the test exe for assembly info, so a slow probe fails the
         lane with "no tests available" and no failing test (xunit/xunit#3576, fixed in 4.0.0). 3.2.2
         is the last 3.x, so there is no backport to take instead. Checked while writing that issue:
         Avalonia.Headless.XUnit 12.1.3, the newest published, still declares 3.2.2. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the logic suite rather than copied: one fake daemon, so a change to
         IDaemonTransport can't leave two drifting stand-ins behind. -->
    <!-- The library suite owns these now; both app suites compile them from there so there is one copy. -->
    <Compile Include="..\OtdInterop.Tests\MemorySettingsFileStore.cs" Link="MemorySettingsFileStore.cs" />
    <Compile Include="..\OtdInterop.Tests\FakeDaemonTransport.cs" Link="FakeDaemonTransport.cs" />
    <Compile Include="..\OtdInterop.Tests\NullOtdLog.cs" Link="NullOtdLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenTabletArtist\OpenTabletArtist.csproj" />
  </ItemGroup>

</Project>
