<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>OpenTabletArtist.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Testing Platform, not VSTest (#756). xunit v3 test projects are executables that
         host their own runner; TestingPlatformDotnetTestSupport tells `dotnet test` to run that host
         instead of going through the VSTest bridge, and OutputType=Exe is what xunit v3 requires once
         Microsoft.NET.Test.Sdk is no longer there to set it.

         So xunit.runner.visualstudio, Microsoft.NET.Test.Sdk and coverlet.collector are gone: the
         first two are the VSTest path, and coverlet.collector is a VSTest data collector that nothing
         collected — no workflow ran with coverage and there is no .runsettings in the tree.

         One gotcha for local use: passing a VSTest filter to `dotnet test` no longer filters anything.
         It warns (MTP0001, "VSTest-specific properties ... will be ignored"), runs the whole suite and
         exits 0, which is easy to miss in a wall of output. Filter by running the test exe directly,
         which takes xunit's own switches:

             bin/Debug/net10.0/<suite>.exe -class Namespace.ClassName
             bin/Debug/net10.0/<suite>.exe -method Namespace.ClassName.MethodName

         CI is unaffected: it runs `dotnet test <csproj>` in its usual no-build form with no filter,
         which works unchanged, and a failing test still exits non-zero (checked, not assumed). -->

    <!-- xunit v3, matching the UI suite (#756). The two used to sit on different majors, which meant
         two runners to migrate rather than one; they now share this line. Held at 3.x by
         Avalonia.Headless.XUnit - see the note in the UI test project. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library suite owns these; this suite's own app-level tests still need a stand-in daemon, and
         one copy of it is better than two that drift. -->
    <Compile Include="..\OtdInterop.Tests\MemorySettingsFileStore.cs" Link="MemorySettingsFileStore.cs" />
    <Compile Include="..\OtdInterop.Tests\FakeDaemonTransport.cs" Link="FakeDaemonTransport.cs" />
    <Compile Include="..\OtdInterop.Tests\NullOtdLog.cs" Link="NullOtdLog.cs" />
    <Compile Include="..\OtdInterop.Tests\UnwritablePath.cs" Link="UnwritablePath.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenTabletArtist\OpenTabletArtist.csproj" />
    <!-- Build the plugin (don't reference its assembly) so the type-name guard test (#104) always
         finds its DLL — including release CI, which tests before the solution/plugin build.
         SkipGetTargetFrameworkProperties avoids the net10→net8 TFM compatibility check. -->
    <ProjectReference Include="..\..\plugins\OpenTabletArtist.Dynamics\OpenTabletArtist.Dynamics.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

</Project>
