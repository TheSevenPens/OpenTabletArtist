<UserControl x:Class="OpenTabletArtist.Views.DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:OpenTabletArtist.Converters">

    <!-- DataContext is the DashboardViewModel, supplied by the typed-nav DataTemplate (#15). No page
         title — the highlighted "home" wordmark in the top bar names the section (Zune). Home stays
         quiet: content (Needs attention / Your tablets) leads directly. -->
    <!-- Two-column Home (#combine): the home content on the left, the folded-in About content on the
         right. Left-aligned block, capped so the two columns stay a comfortable reading width. -->
    <Grid ColumnDefinitions="*,32,*" MaxWidth="1360" HorizontalAlignment="Left">
        <!-- LEFT — about · tablets. About/Resources lead as a short preamble, above the tablets
             they introduce; everything wanting attention lives in the right column. -->
        <StackPanel Grid.Column="0">
            <!-- (The embedded OTD version + OTD UX launcher moved to the Advanced → OTD page.) -->


            <!-- The folded-in About content (what-is · resources · version), rendered from the
                 AboutViewModel via the typed-nav DataTemplate so the markup isn't duplicated. -->
            <ContentControl Content="{Binding About}" />

            <!-- YOUR TABLETS: the former standalone Tablets page, merged into Home (#317). The cards are
                 navigable (Settings) and mirror the sidebar's per-tablet children with detection timing
                 + specs. -->
            <TextBlock Text="your tablets" Classes="Display" Margin="0,18,0,12" />
            <ItemsControl ItemsSource="{Binding TabletsOverview.Tablets}"
                          IsVisible="{Binding TabletsOverview.HasTablets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Double-click the card to open the tablet's settings (#tablet-card-mapping): the
                             per-card "edit" button was removed in favour of this, so the card is one clear
                             target. The Forget button still handles its own click. -->
                        <c:Entity Icon="{StaticResource IconMonitor}"
                                  DoubleTapped="OnTabletCardDoubleTapped"
                                  ToolTip.Tip="Double-click to open this tablet's settings">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <!-- Detection status as the same link / link-off icon the tablet
                                             dropdown uses (#593: both neutral — the link vs link-off icon,
                                             not colour, shows state); the old "Detected"/"Not detected" word
                                             is now the icon's tooltip. -->
                                        <Panel Width="16" Height="16" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding StatusText}">
                                            <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16"
                                                      Foreground="{DynamicResource NeutralBrush}"
                                                      IsVisible="{Binding IsDetected}" />
                                            <PathIcon Data="{StaticResource IconLinkOff}" Width="16" Height="16"
                                                      Foreground="{DynamicResource NeutralBrush}"
                                                      IsVisible="{Binding !IsDetected}" />
                                        </Panel>
                                    </StackPanel>
                                    <!-- Where the active area is mapped (#tablet-card-mapping): the mapped
                                         display when it's a clean single-monitor mapping, or a "needs attention"
                                         line when it isn't. State reads from the wording, not colour (#no-orange-text):
                                         the attention line is a touch more prominent (primary vs secondary text). -->
                                    <TextBlock Text="{Binding MappingText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               IsVisible="{Binding MappingIsNormal}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MappingText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               IsVisible="{Binding MappingNeedsAttention}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <!-- The quiet end of the ramp (TextBlock.Detail): a timestamp is
                                         context, not something you read the card for. -->
                                    <TextBlock Text="{Binding LastSeenDetail}" Margin="0,2,0,0" Classes="Detail"
                                               IsVisible="{Binding HasLastSeenDetail}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <!-- Forget (remove saved settings). Managing connections lives here on Home.
                                         Offered for every tablet (#575): removes a remembered one, or resets a
                                         connected one to defaults — the confirm dialog says which. -->
                                    <!-- A c:IconButton rather than a hand-rolled GhostButton wrapping a
                                         PathIcon: same thing, but it picks up the shared borderless icon
                                         treatment (#row-actions) instead of drifting from it. -->
                                    <c:IconButton Icon="{StaticResource IconTrashCanOutline}"
                                                  Command="{Binding ForgetCommand}"
                                                  ToolTip.Tip="Forget this tablet"
                                                  AutomationProperties.Name="Forget this tablet" />
                                </StackPanel>
                            </Grid>
                        </c:Entity>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No tablets at all → a quiet inline empty state (boxless, left-aligned to the section
                 rhythm — the full Zune hero lives on the TABLET page). -->
            <StackPanel Spacing="4" Margin="0,0,0,6" IsVisible="{Binding !TabletsOverview.HasTablets}">
                <TextBlock Text="No tablets connected or remembered"
                           FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Connect a tablet and it'll appear here."
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- (The run-at-startup toggle moved to its own Advanced → Startup page.) -->

        </StackPanel>

        <!-- RIGHT — everything wanting attention, and nothing else. Both children hide themselves
             when nothing is wrong, so on a healthy machine this column is empty by design: the
             blank right half IS the "all good" signal. -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <!-- Needs attention (#317): the health-check catalog, worst severity first. Hidden entirely
                 when everything is healthy, so Home stays quiet when there's nothing to do. Each card's
                 Fix button runs the relevant action in place or jumps to where the setting lives. -->
            <StackPanel IsVisible="{Binding Health.HasIssues}" Margin="0,0,0,4">
                <!-- Home has no pivot row, so its section headings ARE the page's display layer: 44px
                     Inter Light, lower-case, like the wordmarks and pivots. Left column only — the About
                     column beside it stays on the eyebrow, and that asymmetry is the point. -->
                <TextBlock Text="needs attention" Classes="Display" Margin="0,0,0,18" />
                <ItemsControl ItemsSource="{Binding Health.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Health cards get a tinted per-tier background + border (#509/#574) so they
                                 read distinctly from normal cards, and a per-tier icon in the severity box
                                 (#552). The Alert role owns the tint/border via its Severity tier. -->
                            <c:Alert Margin="0,0,0,8" Padding="14,11"
                                     Severity="{Binding Severity, Converter={x:Static conv:HealthSeverityToAlertSeverityConverter.Instance}}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <!-- Per-tier icon, no coloured box (#health-icon): dark so it reads on the
                                         card's tint, and top-aligned to sit with the title. -->
                                    <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <PathIcon Data="{StaticResource IconAlertCircle}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Broken}" />
                                        <PathIcon Data="{StaticResource IconAlert}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Misconfigured}" />
                                        <PathIcon Data="{StaticResource IconLightbulbOn}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Recommendation}" />
                                        <PathIcon Data="{StaticResource IconInformationOutline}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Information}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Title}" Classes="CardTitle" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <!-- Multi-part issues (#artist-pen-health): a review link per offending
                                             setting, each deep-linking to the Pen pivot that owns it. Only the
                                             artist-pen-behavior card sets Links; other issues leave it null. -->
                                        <ItemsControl ItemsSource="{Binding Links}" Margin="0,6,0,0"
                                                      IsVisible="{Binding Links, Converter={StaticResource NotNull}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- A simple bullet list; each item is a clickable link that
                                                         reads "location › setting" and jumps to that pivot. -->
                                                    <Button Command="{Binding $parent[ItemsControl].DataContext.FollowLinkCommand}"
                                                            CommandParameter="{Binding}"
                                                            Theme="{StaticResource LinkButton}" Padding="0,2" Margin="0"
                                                            HorizontalAlignment="Left"
                                                            ToolTip.Tip="Go to this setting">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="•" VerticalAlignment="Top"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- Actions: an optional secondary button (e.g. "Review" → open the
                                         setting) beside the primary Fix. Only two-button issues set Secondary
                                         (#629); most cards show just Fix. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="{Binding Secondary.ActionLabel}"
                                                IsVisible="{Binding Secondary, Converter={StaticResource NotNull}}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemediateSecondaryCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{StaticResource GhostButton}" Padding="12,6" />
                                        <Button Content="{Binding Remediation.ActionLabel}"
                                                IsVisible="{Binding Remediation, Converter={StaticResource NotNull}}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemediateCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{StaticResource AccentButton}" Padding="12,6" />
                                    </StackPanel>
                                </Grid>
                            </c:Alert>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- (Conflicting-driver alert folded into the "Needs attention" health list above (#317).) -->

            <!-- Daemon problem card: the daemon is surfaced on Home only when there's a connection
                 problem or an op is in flight. It morphs to a "Connecting to daemon…" spinner while Fix
                 runs, then clears on success (or reverts to the error). The full status + controls +
                 version live on the Daemon page (Advanced → OpenTabletDriver). -->
            <c:Alert Severity="Warning" Background="{DynamicResource GlassBgBrush}" Margin="0,0,0,12"
                     IsVisible="{Binding Daemon.ShowDaemonProblem}">
                <Panel>
                    <!-- Connecting… (morph) -->
                    <StackPanel IsVisible="{Binding Daemon.ShowDaemonActivity}">
                        <TextBlock Text="{Binding Daemon.DaemonActivityText}" Classes="CardTitle" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                     Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <!-- Problem (not connecting): message + Fix + Open daemon page. -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                          IsVisible="{Binding !Daemon.ShowDaemonActivity}">
                        <TextBlock Grid.Column="0" Classes="warning" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Daemon.HomeProblemText}" Classes="CardTitle" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Daemon.DaemonOperationError}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding Daemon.HasDaemonOperationError}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Open the daemon page to start it or see details." Margin="0,4,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding Daemon.IsDaemonExeMissing}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Fix" Command="{Binding Daemon.FixCommand}"
                                IsVisible="{Binding Daemon.CanStartDaemon}" IsEnabled="{Binding !Daemon.IsDaemonBusy}"
                                Theme="{StaticResource AccentButton}" Padding="12,6" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Open daemon page" Command="{Binding Daemon.OpenDaemonPageCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Center" />
                    </Grid>
                </Panel>
            </c:Alert>
        </StackPanel>
    </Grid>
</UserControl>
