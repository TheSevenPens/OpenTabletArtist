<UserControl x:Class="OpenTabletArtist.Views.PresetsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- DataContext is the PresetsViewModel, supplied by the typed-nav DataTemplate (#15). Hosted as a
         SETTINGS tab (#571), so the page title is the Settings tab title — no PageTitle here.

         Two columns: the presets themselves on the left, what a preset IS on the right. Definite widths
         rather than star columns — the page is HorizontalAlignment="Left", which sizes a Grid to its
         content, and star columns inside that have nothing to divide. They add up to the 900 the page
         was capped at before. -->
    <Grid ColumnDefinitions="540,32,320" HorizontalAlignment="Left">
    <StackPanel Grid.Column="0">
        <!-- Saving the live config (settings.json) as a preset. This was an accent-outlined bar across
             the top of the page — heading, "In use now" chip and a paragraph explaining that the live
             config saves itself and that everything below is a copy of it. It was an Alert wearing a
             card's chrome, which is the one box the design still reserves for "act on this", and it
             spent the top third of the page saying something no one was in doubt about. The action it
             carried is the part that earned its place. -->
        <Button Content="Save as preset" Theme="{StaticResource AccentButton}"
                HorizontalAlignment="Left"
                Padding="14,7" Margin="0,0,0,20" Command="{Binding SavePresetCommand}" />

        <!-- Header row: section label + Browse (opens the folder where profiles are stored). -->
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,8" IsVisible="{Binding HasPresets}">
            <TextBlock Classes="Display section" Grid.Column="0" Text="saved presets"
                       VerticalAlignment="Center" Margin="0,0,0,0" />
            <c:IconButton Grid.Column="1" Icon="{StaticResource IconFolderOutline}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Open the folder where presets are stored"
                          AutomationProperties.Name="Open the folder where presets are stored"
                          Command="{Binding OpenFolderCommand}"
                          CommandParameter="{Binding PresetDirectory}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Entity>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Classes="CardTitle" Text="{Binding Name}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastModified}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Load" Theme="{StaticResource AccentButton}"
                                        Command="{Binding $parent[ItemsControl].DataContext.LoadPresetCommand}"
                                        CommandParameter="{Binding Name}"
                                        Margin="0,0,6,0" Padding="12,6" />
                                <!-- Everything but Load, behind one control (#preset-overflow). The row
                                     carried five: an accent block, an outlined box and three bare glyphs —
                                     three treatments for one cluster, and by some way the densest row in
                                     the app. Load is why the list exists and it overwrites your live
                                     settings, so it stays a labelled target; Update, Duplicate, Rename and
                                     Delete are all rare and deliberate, and three of the four open a dialog
                                     anyway. Delete keeps the error colour, but as a NAMED item rather than
                                     a red glyph you have to hover to identify.

                                     Click handlers, not Command bindings: a flyout's contents live in a
                                     popup outside this row's visual tree, so $parent[ItemsControl] does not
                                     resolve from in here. LogView's COPY menu is the same pattern. -->
                                <c:IconButton Icon="{StaticResource IconDotsHorizontal}"
                                              ToolTip.Tip="More actions for this preset"
                                              AutomationProperties.Name="More actions">
                                    <c:IconButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Update from current settings"
                                                      Click="OnUpdatePreset" />
                                            <MenuItem Header="Duplicate" Click="OnDuplicatePreset" />
                                            <MenuItem Header="Rename…" Click="OnRenamePreset" />
                                            <Separator />
                                            <MenuItem Header="Delete" Click="OnDeletePreset"
                                                      Foreground="{DynamicResource ErrorBrush}" />
                                        </MenuFlyout>
                                    </c:IconButton.Flyout>
                                </c:IconButton>
                            </WrapPanel>
                        </Grid>
                    </c:Entity>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <c:Section Padding="24" IsVisible="{Binding !HasPresets}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No presets yet" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Save a named backup of your current settings to restore later."
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </c:Section>
    </StackPanel>

        <!-- What a preset is. The page assumed you already knew: it showed a list of names and a Load
             button, and nothing said that Load replaces the settings for every tablet at once. Prose
             rather than a tooltip, because the thing worth knowing is what the whole page does. -->
        <c:Section Grid.Column="2" VerticalAlignment="Top" Title="What a preset is">
            <StackPanel Spacing="10">
                <TextBlock TextWrapping="Wrap"
                           Text="A preset is a named copy of OpenTabletDriver's whole configuration — every tablet you have set up, with its area, mapping, pen settings and filters, saved together in one file." />
                <TextBlock TextWrapping="Wrap"
                           Text="Saving one leaves your current settings alone; it takes a copy. Loading one replaces the live settings for every tablet at once, so it switches your whole setup rather than one tablet's." />
                <TextBlock TextWrapping="Wrap"
                           Text="Presets are also what Settings → Hotkeys switches between: give a preset a key combination there and it loads on that key, even when OpenTabletArtist isn't the focused window." />
            </StackPanel>
        </c:Section>
    </Grid>
</UserControl>
