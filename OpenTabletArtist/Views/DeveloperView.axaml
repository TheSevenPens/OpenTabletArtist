<UserControl x:Class="OpenTabletArtist.Views.DeveloperView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:OpenTabletArtist.Converters">

    <!-- DataContext is the DeveloperViewModel; controls bind to the shared DeveloperSettings singleton
         (Settings.*). Tabbed layout — a tab per topic — so the page stays short as options grow. Hosted as
         a gated SETTINGS tab (#572), so the page title is the Settings tab title — no PageTitle here. -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

        <!-- Tab rail — one tab per topic (matches the tablet page's rail). -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel Width="{StaticResource TabRailWidth}" Spacing="2">
                <RadioButton Content="FORCE WARNINGS" IsChecked="True" x:Name="ForceWarningsTab"
                             Theme="{StaticResource TabRadioButton}" />
                <RadioButton Content="INTERFACE" x:Name="InterfaceTab"
                             Theme="{StaticResource TabRadioButton}" />
                <RadioButton Content="SCREENSHOTS" x:Name="ScreenshotsTab"
                             Theme="{StaticResource TabRadioButton}" />
                <RadioButton Content="GRADIENTS" x:Name="GradientsTab"
                             Theme="{StaticResource TabRadioButton}" />
            </StackPanel>
        </Border>

        <!-- FORCE WARNINGS: two columns — synthetic catalog-warning toggles on the left, and real
             (persisted) config-error triggers on the right. Both drive Home's "Needs attention" list. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #ForceWarningsTab.IsChecked}">
            <Grid ColumnDefinitions="*,32,*" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- LEFT: force each real catalog warning with its true copy (synthetic, non-persisted). -->
                <c:Section Grid.Column="0" Title="Trigger health warnings"
                           Description="Each toggle makes the real catalog warning appear in Home's Needs attention list with its true text and Fix button. Turn it off to remove the card.">
                    <StackPanel Spacing="4">
                        <c:ToggleSetting Label="Windows Ink plugin not installed"
                                         IsChecked="{Binding Settings.ForceWinInkNotInstalled}" />
                        <c:ToggleSetting Label="Windows Ink plugin may be incompatible"
                                         IsChecked="{Binding Settings.ForceWinInkVersionMismatch}" />
                        <c:ToggleSetting Label="VMulti driver not installed"
                                         IsChecked="{Binding Settings.ForceVMultiNotInstalled}" />
                        <c:ToggleSetting Label="Conflicting tablet driver detected"
                                         IsChecked="{Binding Settings.ForceDriverConflict}" />
                        <c:ToggleSetting Label="Running as administrator"
                                         IsChecked="{Binding Settings.ForceRunningElevated}" />
                        <c:ToggleSetting Label="Tray icon can't be shown"
                                         Description="GNOME with no StatusNotifierItem host; Linux-only in reality."
                                         IsChecked="{Binding Settings.ForceTrayHostUnavailable}" />
                        <c:ToggleSetting Label="Using an external daemon"
                                         IsChecked="{Binding Settings.ForceForeignDaemon}" />
                        <c:ToggleSetting Label="Tablet: not using Windows Ink"
                                         Description="Emitted for a sample tablet; its Fix deep-links to that (absent) tablet."
                                         IsChecked="{Binding Settings.ForceTabletNotWinInk}" />
                        <c:ToggleSetting Label="Tablet: mapped area partly off-screen"
                                         IsChecked="{Binding Settings.ForceTabletMappingOffScreen}" />
                        <c:ToggleSetting Label="Tablet: custom display mapping"
                                         IsChecked="{Binding Settings.ForceTabletMappingCustom}" />
                        <c:ToggleSetting Label="Tablet: using a custom config override"
                                         Description="Emitted for a sample tablet; its Review deep-links to the CONFIGS tab."
                                         IsChecked="{Binding Settings.ForceTabletConfigOverride}" />
                        <c:ToggleSetting Label="Tablet: pen isn't set up for drawing"
                                         Description="The artist-pen-behavior bundle for a sample tablet — all four offenders, with per-setting review links."
                                         IsChecked="{Binding Settings.ForceArtistPenBehavior}" />
                    </StackPanel>
                </c:Section>

                <!-- RIGHT: introduce REAL (persisted) misconfigurations for reproducing UX issues, and force
                     a supported tablet into Home's list for debugging without the hardware. -->
                <StackPanel Grid.Column="2" Spacing="24">
                <c:Section Title="Introduce config errors"
                           Description="These make a real, persisted settings change on the active tablet, so the matching warning appears for genuine bad state. Undo each from the tablet's own tabs.">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Map active area partly off-screen" FontWeight="SemiBold" />
                            <Button Content="Push active area off-screen"
                                    Command="{Binding PushMappingOffScreenCommand}"
                                    Theme="{StaticResource GhostButton}" Padding="12,6"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rotate active area to a non-standard angle" FontWeight="SemiBold" />
                            <Button Content="Set rotation to 20°"
                                    Command="{Binding PushMappingRotationCommand}"
                                    Theme="{StaticResource GhostButton}" Padding="12,6"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Create a slightly-wrong calibration" FontWeight="SemiBold" />
                            <Button Content="Create off calibration"
                                    Command="{Binding CreateBadCalibrationCommand}"
                                    Theme="{StaticResource GhostButton}" Padding="12,6"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Break the pen for drawing (artist health check)" FontWeight="SemiBold" />
                            <Button Content="Turn off Windows Ink + tip + pressure + tilt"
                                    Command="{Binding BreakPenForDrawingCommand}"
                                    Theme="{StaticResource GhostButton}" Padding="12,6"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding ConfigErrorStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding HasConfigErrorStatus}" Margin="0,2,0,0" />
                    </StackPanel>
                </c:Section>

                <!-- Force a supported tablet into Home's tablet list (#force-tablet): adds a real, saved
                     (but not-detected) profile so its card can be exercised without the hardware. -->
                <c:Section Title="Force a tablet in the list"
                           Description="Add a saved (remembered, not-detected) profile for any tablet OpenTabletDriver supports, so it shows in Home's tablet list without the hardware — handy for exercising the card, its mapped-display line, and navigation. It's a real profile: remove it with the card's Forget button, or Clear here. Adding a tablet replaces the one previously forced this session.">
                    <StackPanel Spacing="10">
                        <AutoCompleteBox ItemsSource="{Binding SupportedTabletNames}"
                                         SelectedItem="{Binding SelectedForcedTablet, Mode=TwoWay}"
                                         FilterMode="ContainsOrdinal"
                                         MinWidth="300" MaxWidth="380" HorizontalAlignment="Left"
                                         PlaceholderText="Type to find a tablet…" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add to tablet list" Command="{Binding AddForcedTabletCommand}"
                                    Theme="{StaticResource AccentButton}" Padding="12,6" />
                            <Button Content="Clear" Command="{Binding ClearForcedTabletCommand}"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding ForceTabletStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding HasForceTabletStatus}" Margin="0,2,0,0" />
                    </StackPanel>
                </c:Section>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- INTERFACE: two columns — tablet-page extras (hidden tabs / controls) on the left, the
             force-window-size presets on the right. Both tweak how the app's own UI is shown. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #InterfaceTab.IsChecked}">
            <Grid ColumnDefinitions="*,32,*" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- LEFT: reveal the normally-hidden tablet-page tabs / controls. -->
                <c:Section Grid.Column="0" Title="Tablet page extras"
                           Description="Show extra diagnostic tabs and rarely-needed controls on a tablet's page. Hidden by default.">
                    <StackPanel Spacing="4">
                        <c:ToggleSetting Label="Show the Filters tab"
                                         IsChecked="{Binding Settings.ShowFiltersTab}" />
                        <c:ToggleSetting Label="Show the JSON tab"
                                         IsChecked="{Binding Settings.ShowJsonTab}" />
                        <c:ToggleSetting Label="Show the ‘Cut below input minimum’ pressure option"
                                         Description="Re-enable the dead-zone checkbox in Pressure Dynamics (#569)."
                                         IsChecked="{Binding Settings.ShowCutBelowMinimum}" />
                        <c:ToggleSetting Label="Show card-role tags"
                                         Description="Overlay a SECTION / ALERT / SELECT tag on the bottom-right of every card (#574) — a dev aid for the cardless redesign."
                                         IsChecked="{Binding Settings.ShowCardRoleTags}" />
                    </StackPanel>
                </c:Section>

                <!-- RIGHT: window-size presets. -->
                <!-- Force the window to an exact ACTUAL-PIXEL size (#546) — preview small-display layouts or
                     get a consistent window for screenshots. Presets are real pixels (scaling-independent)
                     and relax the normal minimum. Reset by restarting the app. -->
                <c:Section Grid.Column="2" Title="Window size"
                           Description="Force the app window to an exact pixel size — for previewing small-display layouts or consistent screenshots. Reset by restarting.">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current size:" FontWeight="SemiBold" />
                            <TextBlock x:Name="WindowSizeText" Text="—"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Wraps so every preset stays reachable when the window itself is forced narrow. -->
                        <WrapPanel>
                            <Button Content="2560 × 1440" Tag="2560,1440" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1920 × 1080" Tag="1920,1080" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1600 × 900" Tag="1600,900" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1366 × 768" Tag="1366,768" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1280 × 720" Tag="1280,720" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </c:Section>
            </Grid>
        </ScrollViewer>

        <!-- SCREENSHOTS: its own tab rather than a column of INTERFACE. It was folded in there when an
             older Screenshot tab was retired, but it is a capture tool, not a way of showing the UI, and
             it had outgrown sharing a column with the window-size presets. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #ScreenshotsTab.IsChecked}">
            <!-- Capture the live app UI to a PNG via RenderTargetBitmap (#437). Renders the actual
                 controls, so it's pixel-perfect and free of the window-focus / occlusion / DPI issues that
                 plague manual capture. The render happens in code-behind (it needs the visual). -->
            <c:Section Title="Screenshots" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Screenshot all pages" FontWeight="SemiBold" />
                        <TextBlock Text="Visit every page in turn — Home, each nav item, and every Advanced sub-tab — saving an image of each into a new timestamped folder, then return to this page."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <TextBlock Text="Format" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ComboBox MinWidth="120" VerticalAlignment="Center"
                                      ItemsSource="{Binding Settings.ScreenshotFormatOptions}"
                                      SelectedItem="{Binding Settings.ScreenshotFormat, Mode=TwoWay}"
                                      ToolTip.Tip="Image format for screenshots — PNG (lossless), JPG (smaller), or both. Applies to the on-page capture too." />
                        </StackPanel>
                        <Button Content="Screenshot all pages" Click="OnScreenshotAllPages"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <c:ToggleSetting Label="On-page screenshot control"
                                     Description="Show a small Capture page button at the bottom of the nav bar, so you can screenshot whichever page you're currently viewing."
                                     IsChecked="{Binding Settings.OnPageScreenshot}" />

                    <TextBlock x:Name="ScreenshotStatus" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" IsVisible="False" />
                </StackPanel>
            </c:Section>
        </ScrollViewer>

        <!-- GRADIENTS (#556): live editor for the code-generated Sakura backdrop's glows. Each row edits one
             radial glow anchored to the bottom of the window; changes rebuild AppBackdropGlowBrush live (only
             visible when Sakura → "CodeGen background" is selected). The read-only JSON box at the bottom is
             the copy-back target: tune here, paste the JSON to bake it into GradientBackground.Defaults(). -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding Gradients}"
                      IsVisible="{Binding #GradientsTab.IsChecked}">
            <StackPanel Spacing="12" MaxWidth="1120" HorizontalAlignment="Left">

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Tune the glows for the Sakura ‘CodeGen background’. Select it first (Interface → Skin → Sakura) to see changes live. Each glow is a soft radial blob anchored to the bottom (or top) edge." />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Add gradient" Command="{Binding AddGlowCommand}"
                            Theme="{StaticResource GhostButton}" Padding="12,6" />
                    <Button Content="Reset to defaults" Command="{Binding ResetGlowsCommand}"
                            Theme="{StaticResource GhostButton}" Padding="12,6" />
                </StackPanel>

                <!-- The base background colour lives in Settings → Appearance (it's a theme-level tint); the
                     glows below are the gradient detail. -->

                <!-- Two-column flow so more glows fit without long scrolling. -->
                <ItemsControl ItemsSource="{Binding Glows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="0" Padding="10" Margin="0,0,12,12">
                                <StackPanel Spacing="3">
                                    <c:LabeledSlider Label="Center X" LabelWidth="82" Minimum="0" Maximum="1"
                                                     Value="{Binding CenterX}" ValueFormat="0.00" />
                                    <c:LabeledSlider Label="Width" LabelWidth="82" Minimum="0.05" Maximum="1.5"
                                                     Value="{Binding Width}" ValueFormat="0.00" />
                                    <c:LabeledSlider Label="Height (px)" LabelWidth="82" Minimum="0" Maximum="600"
                                                     Value="{Binding HeightPx}" ValueFormat="0" />
                                    <c:LabeledSlider Label="Opacity" LabelWidth="82" Minimum="0" Maximum="1"
                                                     Value="{Binding CenterOpacity}" ValueFormat="0.00" />
                                    <!-- Colour: the unified picker (wheel + palette + hex in a flyout), plus the
                                         top/bottom anchor, on one compact row. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <c:ColorPicker VerticalAlignment="Center"
                                                       Color="{Binding Color, Mode=TwoWay,
                                                               Converter={x:Static conv:HexColorConverter.Instance}}" />
                                        <CheckBox Content="Top" VerticalAlignment="Center"
                                                  ToolTip.Tip="Anchor this glow to the top edge (default: bottom)"
                                                  IsChecked="{Binding Top}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Duplicate"
                                                Command="{Binding $parent[ItemsControl].DataContext.DuplicateGlowCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{StaticResource GhostButton}" Padding="10,4" />
                                        <Button Content="Remove"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveGlowCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{StaticResource GhostButton}" Padding="10,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Settings (copy this back to bake in as the default)" FontWeight="SemiBold" />
                <TextBox Text="{Binding SettingsText, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="160"
                         FontFamily="{DynamicResource MonoFontFamily}"
                         VerticalContentAlignment="Top" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
