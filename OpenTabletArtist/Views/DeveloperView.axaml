<UserControl x:Class="OpenTabletArtist.Views.DeveloperView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:OpenTabletArtist.Converters">

    <!-- DataContext is the DeveloperViewModel; controls bind to the shared DeveloperSettings singleton
         (Settings.*). Tabbed layout — a tab per topic — so the page stays short as options grow. Hosted as
         a gated SETTINGS tab (#572), so the page title is the Settings tab title — no PageTitle here. -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

        <!-- Subtab rail — one subtab per topic. Developer is the only page that divides a third time
             (page menu -> tab menu -> subtabs), so this is the app's only vertical rail; the tablet page
             had one until it moved to the horizontal tab menu. Each subtab is a RadioButton in one
             implicit group, with the pane below bound to its IsChecked. -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel Width="{StaticResource SubtabRailWidth}" Spacing="2">
                <RadioButton Content="WARNINGS" IsChecked="True" x:Name="WarningsSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
                <RadioButton Content="CONFIG ERRORS" x:Name="ConfigErrorsSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
                <RadioButton Content="TABLETS" x:Name="TabletsSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
                <RadioButton Content="INTERFACE" x:Name="InterfaceSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
                <RadioButton Content="SCREENSHOTS" x:Name="ScreenshotsSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
                <RadioButton Content="GRADIENTS" x:Name="GradientsSubtab"
                             Theme="{StaticResource SubtabRadioButton}" />
            </StackPanel>
        </Border>

        <!-- WARNINGS: force each real catalog warning with its true copy. Synthetic and non-persisted —
             nothing on disk changes, the warning is simply asserted into Home's Needs attention list. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #WarningsSubtab.IsChecked}">
            <c:Section MaxWidth="1040" HorizontalAlignment="Left" Title="Trigger health warnings"
                       Description="Each toggle makes the real catalog warning appear in Home's Needs attention list with its true text and Fix button. Turn it off to remove the card.">
                <!-- Two columns, split where the catalog already splits: app- and system-level warnings on
                     the left, the per-tablet ones (every label prefixed "Tablet:") on the right. Twelve in
                     one column ran past the fold; neither half does. -->
                <Grid ColumnDefinitions="*,32,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                    <c:ToggleSetting Label="Windows Ink plugin not installed"
                                     IsChecked="{Binding Settings.ForceWinInkNotInstalled}" />
                    <c:ToggleSetting Label="Windows Ink plugin may be incompatible"
                                     IsChecked="{Binding Settings.ForceWinInkVersionMismatch}" />
                    <c:ToggleSetting Label="VMulti driver not installed"
                                     IsChecked="{Binding Settings.ForceVMultiNotInstalled}" />
                    <c:ToggleSetting Label="Conflicting tablet driver detected"
                                     IsChecked="{Binding Settings.ForceDriverConflict}" />
                    <c:ToggleSetting Label="Running as administrator"
                                     IsChecked="{Binding Settings.ForceRunningElevated}" />
                    <c:ToggleSetting Label="Tray icon can't be shown"
                                     Description="GNOME with no StatusNotifierItem host; Linux-only in reality."
                                     IsChecked="{Binding Settings.ForceTrayHostUnavailable}" />
                    <c:ToggleSetting Label="Using an external daemon"
                                     IsChecked="{Binding Settings.ForceForeignDaemon}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                    <c:ToggleSetting Label="Tablet: not using Windows Ink"
                                     Description="Emitted for a sample tablet; its Fix deep-links to that (absent) tablet."
                                     IsChecked="{Binding Settings.ForceTabletNotWinInk}" />
                    <c:ToggleSetting Label="Tablet: mapped area partly off-screen"
                                     IsChecked="{Binding Settings.ForceTabletMappingOffScreen}" />
                    <c:ToggleSetting Label="Tablet: custom display mapping"
                                     IsChecked="{Binding Settings.ForceTabletMappingCustom}" />
                    <c:ToggleSetting Label="Tablet: using a custom config override"
                                     Description="Emitted for a sample tablet; its Review deep-links to the CONFIGS tab."
                                     IsChecked="{Binding Settings.ForceTabletConfigOverride}" />
                    <c:ToggleSetting Label="Tablet: pen isn't set up for drawing"
                                     Description="The artist-pen-behavior bundle for a sample tablet — all four offenders, with per-setting review links."
                                     IsChecked="{Binding Settings.ForceArtistPenBehavior}" />
                    </StackPanel>
                </Grid>
            </c:Section>
        </ScrollViewer>

        <!-- CONFIG ERRORS: the opposite of WARNINGS — these write a REAL, persisted change to the active
             tablet, so the matching warning appears for genuine bad state rather than being asserted.
             Undo each from the tablet's own tabs. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #ConfigErrorsSubtab.IsChecked}">
            <c:Section MaxWidth="640" HorizontalAlignment="Left" Title="Introduce config errors"
                       Description="These make a real, persisted settings change on the active tablet, so the matching warning appears for genuine bad state. Undo each from the tablet's own tabs.">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Map active area partly off-screen" FontWeight="SemiBold" />
                        <Button Content="Push active area off-screen"
                                Command="{Binding PushMappingOffScreenCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Rotate active area to a non-standard angle" FontWeight="SemiBold" />
                        <Button Content="Set rotation to 20°"
                                Command="{Binding PushMappingRotationCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Create a slightly-wrong calibration" FontWeight="SemiBold" />
                        <Button Content="Create off calibration"
                                Command="{Binding CreateBadCalibrationCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Break the pen for drawing (artist health check)" FontWeight="SemiBold" />
                        <Button Content="Turn off Windows Ink + tip + pressure + tilt"
                                Command="{Binding BreakPenForDrawingCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ConfigErrorStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding HasConfigErrorStatus}" Margin="0,2,0,0" />
                </StackPanel>
            </c:Section>
        </ScrollViewer>

        <!-- TABLETS: force a supported tablet into Home's list (#force-tablet) — a real, saved but
             not-detected profile, so its row can be exercised without the hardware. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #TabletsSubtab.IsChecked}">
            <c:Section MaxWidth="640" HorizontalAlignment="Left" Title="Force a tablet in the list"
                       Description="Add a saved (remembered, not-detected) profile for any tablet OpenTabletDriver supports, so it shows in Home's tablet list without the hardware — handy for exercising the row, its mapped-display line, and navigation. It's a real profile: remove it with the row's trash icon, or Clear here. Adding a tablet replaces the one previously forced this session.">
                <StackPanel Spacing="10">
                    <AutoCompleteBox ItemsSource="{Binding SupportedTabletNames}"
                                     SelectedItem="{Binding SelectedForcedTablet, Mode=TwoWay}"
                                     FilterMode="ContainsOrdinal"
                                     MinWidth="300" MaxWidth="380" HorizontalAlignment="Left"
                                     PlaceholderText="Type to find a tablet…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add to tablet list" Command="{Binding AddForcedTabletCommand}"
                                Theme="{StaticResource AccentButton}" Padding="12,6" />
                        <Button Content="Clear" Command="{Binding ClearForcedTabletCommand}"
                                Theme="{StaticResource GhostButton}" Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding ForceTabletStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding HasForceTabletStatus}" Margin="0,2,0,0" />
                </StackPanel>
            </c:Section>
        </ScrollViewer>

        <!-- INTERFACE: two columns — tablet-page extras (hidden tabs / controls) on the left, the
             force-window-size presets on the right. Both tweak how the app's own UI is shown. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #InterfaceSubtab.IsChecked}">
            <Grid ColumnDefinitions="*,32,*" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- LEFT: reveal the normally-hidden tablet-page tabs / controls. -->
                <c:Section Grid.Column="0" Title="Tablet page extras"
                           Description="Show extra diagnostic tabs and rarely-needed controls on a tablet's page. Hidden by default.">
                    <StackPanel Spacing="4">
                        <c:ToggleSetting Label="Show the Filters tab"
                                         IsChecked="{Binding Settings.ShowFiltersTab}" />
                        <c:ToggleSetting Label="Show the JSON tab"
                                         IsChecked="{Binding Settings.ShowJsonTab}" />
                        <c:ToggleSetting Label="Show the ‘Cut below input minimum’ pressure option"
                                         Description="Re-enable the dead-zone checkbox in Pressure Dynamics (#569)."
                                         IsChecked="{Binding Settings.ShowCutBelowMinimum}" />
                        <c:ToggleSetting Label="Show card-role tags"
                                         Description="Overlay a SECTION / ALERT / SELECT tag on the bottom-right of every card (#574) — a dev aid for the cardless redesign."
                                         IsChecked="{Binding Settings.ShowCardRoleTags}" />
                    </StackPanel>
                </c:Section>

                <!-- RIGHT: window-size presets. -->
                <!-- Force the window to an exact ACTUAL-PIXEL size (#546) — preview small-display layouts or
                     get a consistent window for screenshots. Presets are real pixels (scaling-independent)
                     and relax the normal minimum. Reset by restarting the app. -->
                <c:Section Grid.Column="2" Title="Window size"
                           Description="Force the app window to an exact pixel size — for previewing small-display layouts or consistent screenshots. Reset by restarting.">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current size:" FontWeight="SemiBold" />
                            <TextBlock x:Name="WindowSizeText" Text="—"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Wraps so every preset stays reachable when the window itself is forced narrow. -->
                        <WrapPanel>
                            <Button Content="2560 × 1440" Tag="2560,1440" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1920 × 1080" Tag="1920,1080" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1600 × 900" Tag="1600,900" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1366 × 768" Tag="1366,768" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                            <Button Content="1280 × 720" Tag="1280,720" Click="OnSetWindowSize"
                                    Theme="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </c:Section>
            </Grid>
        </ScrollViewer>

        <!-- SCREENSHOTS: its own tab rather than a column of INTERFACE. It was folded in there when an
             older Screenshot tab was retired, but it is a capture tool, not a way of showing the UI, and
             it had outgrown sharing a column with the window-size presets. -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #ScreenshotsSubtab.IsChecked}">
            <!-- Capture the live app UI to a PNG via RenderTargetBitmap (#437). Renders the actual
                 controls, so it's pixel-perfect and free of the window-focus / occlusion / DPI issues that
                 plague manual capture. The render happens in code-behind (it needs the visual). -->
            <c:Section Title="Screenshots" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Screenshot all pages" FontWeight="SemiBold" />
                        <TextBlock Text="Visit every page in turn — Home, each nav item, and every Advanced sub-tab — saving an image of each into a new timestamped folder, then return to this page."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <TextBlock Text="Format" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ComboBox MinWidth="120" VerticalAlignment="Center"
                                      ItemsSource="{Binding Settings.ScreenshotFormatOptions}"
                                      SelectedItem="{Binding Settings.ScreenshotFormat, Mode=TwoWay}"
                                      ToolTip.Tip="Image format for screenshots — PNG (lossless), JPG (smaller), or both. Applies to the on-page capture too." />
                        </StackPanel>
                        <Button Content="Screenshot all pages" Click="OnScreenshotAllPages"
                                Theme="{StaticResource GhostButton}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <c:ToggleSetting Label="On-page screenshot control"
                                     Description="Show a small Capture page button at the bottom of the nav bar, so you can screenshot whichever page you're currently viewing."
                                     IsChecked="{Binding Settings.OnPageScreenshot}" />

                    <TextBlock x:Name="ScreenshotStatus" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" IsVisible="False" />
                </StackPanel>
            </c:Section>
        </ScrollViewer>

        <!-- GRADIENTS (#556): live editor for the code-generated Sakura backdrop's glows. A list of every
             glow beside an inspector for the one you pick (#glow-linear) — which is what makes room for a
             live preview of the selected glow, and keeps the page one screen tall however many glows there
             are. Changes rebuild the edge glow brushes live (only visible when Sakura → "CodeGen
             background" is selected). COPY SETTINGS JSON is the copy-back path: tune here, paste the JSON
             to bake it into GradientBackground.Defaults(). -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding Gradients}"
                      IsVisible="{Binding #GradientsSubtab.IsChecked}">
            <!-- Neither MaxWidth nor HorizontalAlignment on this panel: "Left" sizes it to its CONTENT, which
                 collapses the inspector's star column to whatever the sliders happen to need, and MaxWidth
                 alone then centres the pane and opens a gutter down the left. The inspector caps its own
                 width instead. Same trap as the Plugins columns. -->
            <StackPanel>

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Glows for the Sakura ‘CodeGen background’. Select it in Interface → Skin to see changes live." />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,18">
                    <Button Content="Add gradient" Command="{Binding AddGlowCommand}"
                            Theme="{StaticResource GhostButton}" Padding="12,6" />
                    <Button Content="Reset to defaults" Command="{Binding ResetGlowsCommand}"
                            Theme="{StaticResource GhostButton}" Padding="12,6" />
                    <!-- Kept beside the others rather than pushed to the far right: on a maximized window
                         that is most of a screen away from everything else on the page. -->
                    <Button Content="Copy settings JSON" Click="OnCopyGradientSettings"
                            Theme="{StaticResource GhostButton}" Padding="12,6" Margin="14,0,0,0" />
                </StackPanel>

                <!-- Empty state — every glow can be removed, and the page should say so rather than show
                     an empty column beside an empty inspector. -->
                <TextBlock Text="No glows. Add one, or reset to the defaults."
                           FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding !HasGlows}" />

                <Grid ColumnDefinitions="300,32,Auto" IsVisible="{Binding HasGlows}" HorizontalAlignment="Left">

                    <!-- The list. A glow's identity used to be the colour swatch at the BOTTOM of its card;
                         here it leads the row, painted with the glow itself, beside what the glow is. -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding Glows}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The hairline between rows, as on the tablet list — the ListBox itself
                                     draws nothing, so a row needs its own. -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Height="34"
                                          Background="Transparent">
                                        <Border Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                                                Background="{Binding ChipBrush}" BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Color}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource TypeDetailSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- The inspector. Bound through `Selected.` rather than by setting DataContext, so the
                         "…" menu below still sees the page view model that owns its commands — a flyout's
                         contents live in a popup outside the visual tree and cannot walk up to reach it. -->
                    <!-- A definite Width, not MaxWidth + Left: every row in here is a Grid with a star
                         column (the slider track, the dropdown gutter), and a star column inside a
                         content-sized parent has nothing to divide, so the whole inspector collapses to the
                         width of its labels. -->
                    <StackPanel Grid.Column="2" IsVisible="{Binding HasSelection}" Width="520">

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Classes="Display section" Margin="0"
                                       Text="{Binding Selected.Color}" VerticalAlignment="Center" />
                            <c:IconButton Grid.Column="1" VerticalAlignment="Center"
                                          Icon="{StaticResource IconDotsHorizontal}"
                                          ToolTip.Tip="Gradient actions"
                                          AutomationProperties.Name="Gradient actions">
                                <c:IconButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Duplicate" Command="{Binding DuplicateGlowCommand}"
                                                  CommandParameter="{Binding Selected}" />
                                        <MenuItem Header="Remove" Command="{Binding RemoveGlowCommand}"
                                                  CommandParameter="{Binding Selected}" />
                                    </MenuFlyout>
                                </c:IconButton.Flyout>
                            </c:IconButton>
                        </Grid>

                        <!-- To scale against the 600px glow band, so a 99px reach really does fill a sixth
                             of the strip. The list chips are not — see ChipBrush. -->
                        <Border Height="68" Margin="0,0,0,14" Background="{Binding Selected.PreviewBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" />

                        <Grid ColumnDefinitions="82,*" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="Style" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                                      ItemsSource="{Binding Selected.StyleOptions}"
                                      SelectedItem="{Binding Selected.Style, Mode=TwoWay}"
                                      AutomationProperties.Name="Gradient style">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:LowerCaseConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Was a "Top" checkbox. A checkbox can name two edges; the linear washes need
                             four, and a glow anchored left has no honest checked state. -->
                        <Grid ColumnDefinitions="82,*" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="Edge" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                                      ItemsSource="{Binding Selected.EdgeOptions}"
                                      SelectedItem="{Binding Selected.Edge, Mode=TwoWay}"
                                      ToolTip.Tip="The edge this glow is anchored to; its reach is measured inward from there"
                                      AutomationProperties.Name="Anchor edge">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:LowerCaseConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="82,*" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="Colour" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <c:ColorPicker Grid.Column="1" HorizontalAlignment="Left"
                                           Color="{Binding Selected.Color, Mode=TwoWay,
                                                   Converter={x:Static conv:HexColorConverter.Instance}}" />
                        </Grid>

                        <!-- Radial places a blob somewhere along its edge; a linear wash spans the whole
                             edge, so it trades those two for the shape of its fade. Reach is the one
                             measurement that means the same thing in both, so it is one slider. -->
                        <c:LabeledSlider Label="Center X" LabelWidth="82" Minimum="0" Maximum="1"
                                         Value="{Binding Selected.CenterX, Mode=TwoWay}" ValueFormat="0.00"
                                         IsVisible="{Binding Selected.IsRadial}" />
                        <c:LabeledSlider Label="Width" LabelWidth="82" Minimum="0.05" Maximum="1.5"
                                         Value="{Binding Selected.Width, Mode=TwoWay}" ValueFormat="0.00"
                                         IsVisible="{Binding Selected.IsRadial}" />
                        <c:LabeledSlider Label="Reach" LabelWidth="82" Minimum="0" Maximum="600"
                                         Value="{Binding Selected.ReachPx, Mode=TwoWay}" ValueFormat="0"
                                         ToolTip.Tip="How far the glow reaches in from its edge, in pixels" />
                        <c:LabeledSlider Label="Falloff" LabelWidth="82" Minimum="0.02" Maximum="0.98"
                                         Value="{Binding Selected.Falloff, Mode=TwoWay}" ValueFormat="0.00"
                                         IsVisible="{Binding Selected.IsLinear}"
                                         ToolTip.Tip="Where the wash reaches half opacity: low fades early, high holds the colour and drops away late" />
                        <c:LabeledSlider Label="Opacity" LabelWidth="82" Minimum="0" Maximum="1"
                                         Value="{Binding Selected.CenterOpacity, Mode=TwoWay}" ValueFormat="0.00" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
