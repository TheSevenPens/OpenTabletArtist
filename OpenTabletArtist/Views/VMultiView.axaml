<UserControl x:Class="OpenTabletArtist.Views.VMultiView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- DataContext is the VMultiViewModel, supplied by the typed-nav DataTemplate (#15). Moved off the
         Home page (#317): Home flags a missing driver and directs you here. -->
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

        <c:Section>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Center">
                    <TextBlock Classes="Display section" Text="vmulti driver" TextWrapping="Wrap" Margin="0,0,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding VmultiMessage}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                        <Run Text="Setup API: " /><Run Text="{Binding VmultiSetupApiStatus}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                        <Run Text="HID: " /><Run Text="{Binding VmultiHidStatus}" />
                    </TextBlock>
                    <!-- Install status text (shown during installation) -->
                    <TextBlock Text="{Binding VmultiInstallStatus}"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                               IsVisible="{Binding VmultiInstalling}" />
                    <TextBlock Text="Required for pressure &amp; tilt"
                               Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"
                               Margin="0,2,0,0"
                               IsVisible="{Binding !VmultiInstalled}" />
                </StackPanel>

                <!-- Every action behind one "…", as on the Windows Ink and daemon cards. This card carried
                     a refresh glyph inline beside its heading plus an accent Browse / Install / Uninstall
                     row — and Install and Uninstall are mutually exclusive, so the menu is never longer
                     than three. Uninstall takes the error colour here, matching the other destructive menu
                     items; it used to be an accent button indistinguishable from Install.
                     The install-progress line is NOT here: the left column already showed it, so the copy
                     that lived in this row was the same status printed twice. -->
                <c:IconButton Grid.Column="1" VerticalAlignment="Top"
                              Icon="{StaticResource IconDotsHorizontal}"
                              ToolTip.Tip="VMulti driver actions"
                              AutomationProperties.Name="VMulti driver actions">
                    <c:IconButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Refresh status"
                                      Command="{Binding RefreshVmultiDetectionCommand}" />
                            <Separator />
                            <MenuItem Header="Install"
                                      Command="{Binding InstallVmultiCommand}"
                                      IsVisible="{Binding ShowInstallButton}" />
                            <MenuItem Header="Open install folder"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="C:\Program Files\VMulti" />
                            <MenuItem Header="Uninstall"
                                      Command="{Binding UninstallVmultiCommand}"
                                      IsVisible="{Binding ShowUninstallButton}"
                                      Foreground="{DynamicResource ErrorBrush}" />
                        </MenuFlyout>
                    </c:IconButton.Flyout>
                </c:IconButton>
            </Grid>
        </c:Section>
    </StackPanel>
</UserControl>
