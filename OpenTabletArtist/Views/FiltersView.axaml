<UserControl x:Class="OpenTabletArtist.Views.FiltersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:OpenTabletArtist.Controls">

    <!-- The Filters tab on the Advanced page (#1049). DataContext is the FiltersViewModel, supplied by the
         typed-nav DataTemplate (#15). Filters belong to a tablet's profile, not to the app (#1052), so every
         known tablet gets a section here: the page has no tablet switcher, and one tablet's filters under
         another's name would be wrong. A developer view, shown only when Settings, Developer turns it on. -->
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Each tablet has its own filters. The driver runs them in the order listed."
                   Foreground="{DynamicResource TextMutedBrush}" />

        <ItemsControl ItemsSource="{Binding Tablets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Classes="CardTitle" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" Classes="Detail" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Filters}" IsVisible="{Binding HasFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:Section Padding="16,12" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <!-- Stale leftover from an older app or plugin name: inert, should be cleaned. -->
                                                    <ctrl:Chip Text="Legacy" Kind="Warning" IsVisible="{Binding IsLegacy}"
                                                               ToolTip.Tip="Left over from an older version. The OTD daemon has no plugin for this type, so it does nothing. It will be removed automatically." />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FullPath}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </ctrl:Section>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- This tablet's profile has none. -->
                        <TextBlock Text="No filters configured" IsVisible="{Binding HasNoFilters}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- No tablet is known yet. -->
        <TextBlock Text="No tablets yet. Connect one and its filters will be listed here."
                   TextWrapping="Wrap" IsVisible="{Binding !HasTablets}"
                   Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>
</UserControl>
