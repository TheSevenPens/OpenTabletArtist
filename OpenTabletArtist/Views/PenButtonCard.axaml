<UserControl x:Class="OpenTabletArtist.Views.PenButtonCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- One pen barrel button (#1015). DataContext is a PenButtonRowViewModel, bound by the pen tab to a
         slot (Button N). Same height as the tip and eraser cards: a title, one line saying what the button
         does now, and a "…" menu holding the three choices, built only from bindings OTD already ships:
           Default action     the pen's native behavior (the Barrel Switch under Windows Ink)
           Keyboard shortcut  held while the button is held
           Disabled           nothing bound
         It is the same "…" menu the ExpressKey and wheel rows carry (#row-actions). The first version
         stacked three radios, which made each card up to four times as tall; with five cards in the column
         that pushed the pen's movement and pressing settings off the screen.

         A button set somewhere else (OTD's own UI) has none of the three ticked: the card says what it does
         now and, if that does not suit the output mode, why. Nothing is rewritten unless the user picks. -->
    <c:Section Padding="12,10" Width="240" HorizontalAlignment="Left">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SectionLabel}" Classes="SectionLabel" />
                    <!-- The tooltip says who decides what the Barrel Switch does: your drawing software. -->
                    <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               ToolTip.Tip="{Binding StateTooltip}" />
                </StackPanel>

                <!-- Commands live on the row's own DataContext, which a flyout inherits. A tick marks the saved
                     choice; none is ticked for a binding set elsewhere. -->
                <c:IconButton Grid.Column="1" Icon="{StaticResource IconDotsHorizontal}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Choose what this button does"
                              AutomationProperties.Name="Choose what this button does">
                    <c:IconButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Default action" Command="{Binding UseDefaultActionCommand}"
                                      IsVisible="{Binding CanUseDefaultAction}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding IsDefaultAction}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding ShortcutLabel, StringFormat='{}{0}…'}"
                                      Command="{Binding UseShortcutCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding IsShortcut}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Disabled" Command="{Binding DisableCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding IsDisabled}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </c:IconButton.Flyout>
                </c:IconButton>
            </Grid>

            <!-- Unsuitable for the output mode: plain sentence, and the one-click fix when there is one. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasWarning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconAlert}" Width="15" Height="15" VerticalAlignment="Top"
                              Margin="0,2,0,0" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" MaxWidth="200"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <Button Content="Switch to Barrel Switch" Command="{Binding SwitchToBarrelCommand}"
                        IsVisible="{Binding CanSwitchToBarrel}"
                        Theme="{StaticResource AccentButton}" Padding="12,5" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Two or more buttons are the Barrel Switch: say they do the same thing. -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSharedBarrelHint}">
                <PathIcon Data="{StaticResource IconInformationOutline}" Width="15" Height="15" VerticalAlignment="Top"
                          Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding SharedBarrelHint}" TextWrapping="Wrap" MaxWidth="200"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </StackPanel>
    </c:Section>
</UserControl>
