<UserControl x:Class="OpenTabletArtist.Views.PageHost"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OpenTabletArtist.Views">

    <!-- The area the current page is shown in. DataContext is the MainViewModel.

         A GRID, not a StackPanel (#scribble-fill): a vertical StackPanel offers each child unlimited height, so
         a page that wants "the rest of the window" has no rest to take and falls back to its minimum. In a Grid
         the star row gets whatever the scroll viewer's viewport has left, and a page that fills it grows and
         shrinks with the window; when the window is too short for the page's own minimum, the outer scroll
         viewer still scrolls, as before.

         Only a page that asks gets the space (ContentVerticalAlignment is Stretch for it and Top for every
         other page), so a page that is happy to be as tall as its content keeps being exactly that.

         L/R/bottom padding stays above the Sakura cards' glow extent (16px blur, see CardShadow) so the soft
         glow isn't clipped by the scroll viewport on those edges. -->
    <Border Padding="24,0,24,18">
        <Grid RowDefinitions="Auto,*">
            <!-- A pause stops editing everywhere, so it is announced above the page it stopped rather than in
                 the footer alone (#920). Hidden the rest of the time, when its row is zero tall. -->
            <views:SettingsPausedView Grid.Row="0" />

            <!-- Top-level page switches snap (no transition). A crossfade here superimposed the two pages for
                 ~180ms, which read as a glitch when their content differed a lot (worst Settings → Scribble,
                 whose big flat canvas ghosted over Settings' cards). Sub-page pivots keep their own PageFade. -->
            <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}"
                                         IsEnabled="{Binding PageInputEnabled}"
                                         VerticalAlignment="{Binding ContentVerticalAlignment}"
                                         PageTransition="{x:Null}" />
        </Grid>
    </Border>
</UserControl>
