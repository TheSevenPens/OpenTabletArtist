<UserControl x:Class="OpenTabletArtist.Views.PenSwitchCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- The pen tip and the eraser: two choices, Default action and Disabled, as one bar (the same segments as a
         barrel button's card), and a line saying what the lit one means. DataContext is a PenSwitchRowViewModel,
         which supplies the words, so one card serves both. It replaced a "Working normally" card with, for the
         tip, a separate "Disable pen tip" switch under it, which said one thing in two places.

         There is no Toggle: the tip and the eraser end each press on touch and release on lift, so a toggle
         would flip on every stroke.

         A switch set somewhere else (OTD's own UI) has neither lit: the card says what it does now, and that it
         may not work. Nothing is rewritten unless the user picks. The segments are one-way: the saved binding
         decides which is lit, and a click is only a command. No GroupName, for the reason on PenButtonCard. -->
    <c:Section Padding="12,10" Width="240" HorizontalAlignment="Left">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton Classes="segment" Content="Default action"
                             IsChecked="{Binding IsRecommended, Mode=OneWay}"
                             Command="{Binding SetAutoCommand}" />
                <RadioButton Classes="segment" Content="Disabled"
                             IsChecked="{Binding IsDisabled, Mode=OneWay}"
                             Command="{Binding DisableCommand}" />
            </StackPanel>

            <StackPanel Spacing="3" IsVisible="{Binding IsRecommended}">
                <TextBlock Text="{Binding DefaultTitle}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding DefaultDetail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="3" IsVisible="{Binding IsDisabled}">
                <TextBlock Text="Does nothing" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding DisabledDetail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Set somewhere else: neither is lit. -->
            <StackPanel Spacing="3" IsVisible="{Binding IsNotRecommended}">
                <TextBlock Text="{Binding CurrentPlainLabel, StringFormat='Currently: {0}'}" FontSize="17"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Changed to a custom action. It may not work as expected." TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </c:Section>
</UserControl>
