<UserControl x:Class="OpenTabletArtist.Views.PenSwitchCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- One switch on the Pen Switches tab. DataContext is a PenSwitchRowViewModel, bound by the tab to
         a slot (Tip / Eraser / Button N). Same data/commands as the old list rows, laid out as a compact
         card that the rows layout flows into WrapPanels (tip + eraser, then the buttons). -->
    <!-- Adaptive is the only supported binding for pen switches — under Windows Ink (which OTA's output
         modes use) other binding types silently don't work (#495). Simplified to two plain-language states
         (#pen-inputs-simplify): when it's on the recommended default, one calm "Working normally" line; when
         it's drifted onto something else, a plain sentence + the current binding + a single "Fix". No plugin
         jargon and no coloured badges (the check mark carries "good", per the app's #593 convention). -->
    <c:Section Padding="12,10" Width="240" HorizontalAlignment="Left">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding SectionLabel}" Classes="SectionLabel" />

            <!-- Working (recommended default) — one quiet confirmation line. -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRecommended}">
                <PathIcon Data="{StaticResource IconCheckCircle}" Width="15" Height="15"
                          Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Working normally" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Needs attention — plain problem sentence, the current binding (plain), and one fix. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsNotRecommended}">
                <TextBlock Text="Changed to a custom action — it may not work as expected."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentPlainLabel, StringFormat='Currently: {0}'}"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                <Button Content="Fix" Command="{Binding SetAutoCommand}"
                        IsVisible="{Binding ShowUseAdaptive}"
                        Theme="{StaticResource AccentButton}" Padding="12,5" HorizontalAlignment="Left"
                        ToolTip.Tip="Reset this input to its normal behavior" />
            </StackPanel>
        </StackPanel>
    </c:Section>
</UserControl>
