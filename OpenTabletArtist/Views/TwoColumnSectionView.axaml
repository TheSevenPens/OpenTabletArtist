<UserControl x:Class="OpenTabletArtist.Views.TwoColumnSectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext is the TwoColumnSectionViewModel. Each section resolves to its own view through the
         typed DataTemplates (App.axaml), same as CompositeSectionView — this only decides where they sit.

         A WrapPanel of definite-width blocks (#691). The widths are definite because a star column inside
         a content-sized parent has nothing to divide and collapses; wrapping is what stops those widths —
         520+32+380 is 932, well over the window's 800px minimum — from pushing the right column off the
         edge of a scroller that doesn't scroll sideways. The root stays STRETCHED, since
         HorizontalAlignment="Left" measures with infinite width and would never wrap. Both blocks stay
         top-aligned so they start on the same line however tall each grows. -->
    <WrapPanel ItemSpacing="32" LineSpacing="8">
        <ItemsControl Width="520" ItemsSource="{Binding LeftSections}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Margin="0,0,0,24" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Width="380" ItemsSource="{Binding RightSections}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Margin="0,0,0,24" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </WrapPanel>
</UserControl>
