<UserControl x:Class="OpenTabletArtist.Views.TestView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:OpenTabletArtist.Converters"
             xmlns:views="using:OpenTabletArtist.Views">

    <UserControl.Styles>
        <!-- Small accent chip listing an active dynamics aspect (#184), matching the banner's chip. -->
        <Style Selector="Border.DynChip">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.DynChip > TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Each readout row pairs a proportional label with a monospace value. The two fonts have
             different metrics (Consolas rides higher than the label font), so pin both to the top and
             nudge the mono value down (via Margin on .ReadoutValue below) to align their baselines. -->
        <Style Selector="UniformGrid > StackPanel > TextBlock">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- Fixed value width so the left-aligned, content-sized grid columns don't reflow (jump) as the
             numbers change digit count. Wide enough for a paired "x, y" reading (#scribble-readouts). -->
        <Style Selector="UniformGrid > StackPanel > TextBlock.ReadoutValue">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Width" Value="104" />
        </Style>
    </UserControl.Styles>

    <!-- DataContext is the TestViewModel, supplied by the typed-nav DataTemplate (#15). -->
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top">
            <!-- No page title — the "scribble" wordmark names the section (Zune). -->
            <!-- The chips that spell out which dynamics are actually altering the pen (#184). This
                 was a two-column Grid with the active-tablet switcher on the right; that moved to the
                 shell top bar (#697), so the chips are the whole row now.
                 (Edit the pressure curve + smoothing on the Pen page's "pressure" tab.) -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <!-- The specific-aspect chips spell out exactly what's altering the pen; a generic
                     "Dynamics on" pill was redundant with them, so it was removed. -->
                <Border Classes="DynChip" IsVisible="{Binding CurveActive}">
                    <TextBlock Text="Pressure curve" />
                </Border>
                <Border Classes="DynChip" IsVisible="{Binding PressureSmoothingActive}">
                    <TextBlock Text="Pressure smoothing" />
                </Border>
                <Border Classes="DynChip" IsVisible="{Binding PositionSmoothingActive}">
                    <TextBlock Text="Position smoothing" />
                </Border>
            </WrapPanel>

            <!-- Pointer-only mode paints nothing, so active dynamics are invisible — warn (#183). -->
            <TextBlock Text="Pointer-only mode doesn't draw, so you won't see the dynamics above. Pick a pressure Mode to see them."
                       IsVisible="{Binding PointerOnlyWithDynamics}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- Controls + live readouts, in a ControlPanel (ribbon-style control cluster) — bordered with
                 the Entity glass fill so it reads as a single panel over the themed backdrop. -->
            <c:ControlPanel Margin="0,12,0,0">
                <StackPanel>
                    <!-- Controls: the brush picker and the canvas actions. The picker chooses a BRUSH,
                         which is what it is bound to (BrushModes/BrushMode) and what the list reads as —
                         "Mode" named the enum, not the thing being picked.

                         An App/Driver toggle used to sit at the far right, choosing between the OS pointer
                         and the driver's own stream. Gone (#scribble-driver-only): the pen data is always
                         the driver's now, as it is in every other tablet driver's UI. -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Brush" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding BrushModes}" SelectedItem="{Binding BrushMode}"
                                  MinWidth="200" VerticalAlignment="Center" Margin="0,0,20,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:PenBrushModeNameConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Clear" Command="{Binding ClearCommand}"
                                Theme="{StaticResource GhostButton}" Padding="14,6" />
                        <Button Content="Copy" Click="OnCopy"
                                Theme="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0"
                                ToolTip.Tip="Copy the drawing to the clipboard as an image" />
                        <!-- Marks every report that lands ink with a red dot, on a layer above the brush, so
                             a stroke's individual reports are visible at high report rates. -->
                        <CheckBox Content="Report dots" IsChecked="{Binding ShowReportDots}"
                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                  ToolTip.Tip="Mark each pen report that lands ink with a red dot, to see where reports fall along a stroke" />

                        <!-- Record mode: keep every pen report while you draw, then review and save them as a
                             Stroke Corpus recording. Drawing works as usual while recording. -->
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Recording}" Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <Button Content="Record" Command="{Binding StartCommand}" IsVisible="{Binding IsIdle}"
                                    Theme="{StaticResource GhostButton}" Padding="14,6"
                                    ToolTip.Tip="Record every pen report you make, to save as a Stroke Corpus recording" />
                            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRecording}"
                                    Theme="{StaticResource AccentButton}" Padding="14,6" />
                            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsRecording}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </WrapPanel>


                    <!-- Live readouts. Paired values share a cell (x/y, tilt x/y, az/al) so the panel is 4×2
                         instead of a taller 5-wide grid; left-aligned + content-sized columns keep it
                         horizontally compact on smaller desktops. Monospace values keep the digits from
                         jittering. -->
                    <UniformGrid Columns="4" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                            <TextBlock Text="Canvas:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CanvasText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                            <TextBlock Text="Raw:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RawText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                            <TextBlock Text="Tilt:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TiltText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                            <TextBlock Text="Pressure:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PressureText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                            <TextBlock Text="Twist:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TwistText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <!-- Azimuth and altitude share a cell ("az, al"), like Tilt's x/y pair. -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2"
                                    ToolTip.Tip="Pen azimuth (direction it leans, 0–360°) and altitude (angle above the surface, 90° = upright).">
                            <TextBlock Text="AZ/AL:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding AzAltText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <!-- Hover distance (0–255) — driver-reported. Always shown so the grid layout is stable;
                             blank ("—") in App input, numeric only in Driver input (#hover-readout). -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2"
                                    ToolTip.Tip="Driver-reported hover height (0–255) — shown in Driver input, for tablets that report proximity.">
                            <TextBlock Text="Hover:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding HoverText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                        <!-- Tablet reports per second, live while the pen draws or hovers. Held at the last
                             value when the pen leaves range; restarts on its return. -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2"
                                    ToolTip.Tip="How many reports per second the tablet is sending (its report rate), measured while the pen is drawing or hovering.">
                            <TextBlock Text="Rate:" Width="58" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RateText}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Classes="ReadoutValue" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Where every pen report ended up (counted since the page opened or Clear). Reads as
                         parsed = handled + queued, and handled = drawn + hover + off-canvas — so any report
                         that isn't drawn shows up in one of the other buckets, and "queued" growing means the
                         UI thread is falling behind. Lag is arrival-at-the-app → handled (last second).
                         Hidden, and not counted at all, unless TestViewModel.CountersEnabled is on (set the
                         environment variable OTA_SCRIBBLE_COUNTERS=1). -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsVisible="{Binding CountersEnabled}"
                                ToolTip.Tip="parsed: pen reports received from the driver. queued: received but the UI hasn't handled them yet (should stay near 0). drawn: put ink down. hover: pen up, so no ink. off-canvas: mapped outside the canvas. lag: time from a report arriving to it being handled, average / worst over the last second.">
                        <TextBlock Text="Reports:" Width="58" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CountersText}" FontFamily="{DynamicResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </c:ControlPanel>
        </StackPanel>

        <!-- Paint surface fills the rest. Square corners (override the default card rounding). -->
        <c:Canvas CornerRadius="0" Padding="0" ClipToBounds="True" MinHeight="320">
            <Grid>
                <c:PenTestCanvas x:Name="PaintCanvas"
                                 BrushMode="{Binding BrushMode}"
                                 ShowReportDots="{Binding ShowReportDots}" />
                <!-- Painting needs an Absolute output mode to map the pen's position; otherwise show why
                     the canvas is disabled (#95). -->
                <Border IsVisible="{Binding DriverCanvasDisabled}"
                        Background="#E6F5F5F0" Padding="32">
                    <TextBlock Text="{Binding DriverDisabledNote}"
                               MaxWidth="420" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </c:Canvas>
    </DockPanel>
</UserControl>
