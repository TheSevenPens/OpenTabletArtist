<UserControl x:Class="OpenTabletArtist.Views.PenDetailView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:OpenTabletArtist.Controls"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:otac="using:OpenTabletArtist.Converters"
             xmlns:views="using:OpenTabletArtist.Views">

    <UserControl.Resources>
        <!-- Title over a muted explanation: the item look for the movement and pressing dropdowns. The
             MaxWidth bounds the wrapping description (an open popup may otherwise auto-grow to one
             long line); the labels are body-size text, matching ToggleSetting. -->
        <DataTemplate x:Key="ChoiceOptionTemplate">
            <StackPanel Spacing="2" MaxWidth="300" Margin="0,3">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </DataTemplate>
        <!-- What the CLOSED box shows: the option's name alone. The explanation is for choosing, so it
             appears only in the open list (ChoiceOptionTemplate). -->
        <DataTemplate x:Key="ChoiceOptionNameTemplate">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- The switcher/detection statusDot + statusSquare styles moved into TabletSwitcherBar (#580). -->

    <!-- A single tablet's PEN settings (#pen-split), DataContext is a TabletDetailViewModel (shared with the
         tablet page). Same toolbar structure as the tablet page: switcher · pivots · D/R/F, over the
         pivot-gated content. Only ever embedded in the PEN page, so the switcher/actions always show. -->
    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar row: switcher · pivots (basics · pressure · buttons) · compact actions (D · R · F). -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Margin="0,0,0,14" Padding="0,0,0,7">
            <!-- Pivots only; the switcher moved to the shell top bar (#switcher-in-shell). -->
            <Grid>
                <!-- Pivots — the pen's sub-sections. RadioButtons switched by ElementName; content gates on
                     #XTab.IsChecked. Three, named for what they hold:
                       basics    how the pen moves and presses, and the tip and eraser
                       pressure  the pressure switch, curve and smoothing
                       tilt      whether apps receive the pen's tilt, and two live pictures of it
                       buttons   the barrel buttons and the pen diagram
                     "buttons" is last so the first two sit where they always have, and it is hidden on a pen
                     with no barrel buttons. It was split back out of "basics" (which held the buttons, the
                     diagram, movement, pressing and the input opt-outs in four columns) because those are
                     separate jobs, and the buttons column with its diagram was the odd one out. -->
                <WrapPanel Orientation="Horizontal" x:Name="TabRail" VerticalAlignment="Center">
                    <RadioButton Content="basics" IsChecked="True" x:Name="MovementTab"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                    <!-- The pressure tab (formerly "dynamics") — pressure curve + pressure smoothing. Moved
                         here from the tablet page (#pen-dynamics-move); x:Name kept for the code-behind. -->
                    <RadioButton Content="pressure" x:Name="DynamicsTab"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                    <RadioButton Content="tilt" x:Name="TiltTab"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                    <RadioButton Content="buttons" x:Name="ButtonsTab"
                                 IsVisible="{Binding HasPenButtons}"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                </WrapPanel>

            </Grid>
        </Border>

        <!-- BASICS — how the pen moves and presses, and the tip and eraser. Three columns:
               1  the tip, Default action or Disabled
               2  how the pen moves, then how it presses
               3  the eraser, Default action or Disabled

             Column 2 is the star one: the smoothing slider needs a definite width to render its track,
             since a size-to-content Slider collapses it to nothing. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #MovementTab.IsChecked}">
            <WrapPanel ItemSpacing="32" LineSpacing="20" Margin="0,12,0,0">

                <!-- 1 — the tip: Default action or Disabled. -->
                <StackPanel Width="240" Spacing="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="tip" Classes="Display section" />
                        <views:PenSwitchCard DataContext="{Binding PenTipRow}" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 2 — movement (the choice, then position smoothing), then pressing. -->
                <StackPanel Width="320" VerticalAlignment="Top">
                    <TextBlock Text="movement" Classes="Display section" />

                    <!-- A dropdown, not radios: each option carries a MUTED explanation under its title in the
                         open list; the closed box shows just the name.
                         SelectedMovement derives from the profile and its setter forwards a real pick to
                         SelectMovementCommand (a no-op when the mode is already there). The item template
                         is shared with the pressing dropdown below. -->
                    <ComboBox Margin="0,12,0,0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding MovementOptions}"
                              SelectedItem="{Binding SelectedMovement, Mode=TwoWay}"
                              ItemTemplate="{StaticResource ChoiceOptionTemplate}"
                              SelectionBoxItemTemplate="{StaticResource ChoiceOptionNameTemplate}" />

                    <!-- Position smoothing (EMA), moved here from the Pressure tab: it steadies the pen's
                         on-screen position, so it belongs with movement. Capped at 0.25 (#487): heavier is
                         too laggy to be useful. Sits directly under the movement choice.
                         One top margin, not two: this used to be a single-child StackPanel carrying
                         Margin="0,28,0,0" around a slider carrying another "0,8,0,0", which opened a 36px
                         gap under the radios that nothing else in the column came close to. The wrapper
                         did nothing else — a LabeledSlider stretches to the column width on its own. -->
                    <ctrl:LabeledSlider Label="Position smoothing" LabelWidth="130" Margin="0,20,0,0"
                                        Minimum="0" Maximum="{Binding PositionSmoothingMax}"
                                        Ticks="0,0.05,0.1,0.15,0.2,0.25" TickPlacement="BottomRight"
                                        Value="{Binding PositionSmoothing}"
                                        ValueTextOverride="{Binding PositionSmoothingText}"
                                        Monospace="True" ValueWidth="44"
                                        ToolTip.Tip="EMA smoothing of the pen position — steadies wobbly lines, at a little lag." />

                    <StackPanel IsVisible="{Binding CanDisableWindowsInk}">
                        <!-- The heading style carries only a bottom margin; the gap above is the slider's to the
                             movement choice, 20, so the same here. -->
                        <TextBlock Text="pressing" Classes="Display section" Margin="0,20,0,6" />
                        <ComboBox Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding PressModeOptions}"
                                  SelectedItem="{Binding SelectedPressMode, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource ChoiceOptionTemplate}"
                                  SelectionBoxItemTemplate="{StaticResource ChoiceOptionNameTemplate}" />

                        <!-- Only when the current mode isn't Windows Ink: pressure/tilt won't work; offer a fix. It
                             sits with the Pressing choice because pressure and tilt are what it is about (it used to
                             sit under Movement, which it has nothing to do with). -->
                        <TextBlock Text="Output mode needs to use Windows Ink for pressure and tilt to work"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontStyle="Italic" Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CanFixOutputMode}" />
                        <Button Content="Fix" Theme="{StaticResource AccentButton}"
                                Command="{Binding FixOutputModeCommand}"
                                Padding="12,6" Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding CanFixOutputMode}" />
                    </StackPanel>
                </StackPanel>

                <!-- 3 — the eraser. -->
                <StackPanel Width="240" Spacing="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="eraser" Classes="Display section" />
                        <views:PenSwitchCard DataContext="{Binding PenEraserRow}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Drag bindings hidden for now (#492); the binding + apply wiring stays. -->
                    <ctrl:ToggleSetting Label="Drag bindings" IsVisible="False"
                                        Description="Pen button bindings only work while the pen is touching the tablet (drag-only), not while hovering."
                                        IsChecked="{Binding DragBindingsEnabled}" />
                </StackPanel>

            </WrapPanel>
        </ScrollViewer>

        <!-- TILT — whether apps receive the pen's tilt: Enabled or Disabled, as one bar (the same segments as the
             tip and eraser). Tilt reaches the pointer only when the pen presses normally (Windows Ink). When it
             presses like a mouse the output takes none, so the choice changes nothing: the bar is greyed out,
             with the reason beneath, rather than left looking live (#1015 follow-up). The saved value is
             untouched, so it comes back as it was. The pressure switch is the same on the pressure tab.
             The segments are one-way: the saved setting decides which is lit, and a click is only a command
             (#494 for Disabled: apps receive no tilt from this tablet). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #TiltTab.IsChecked}">
            <WrapPanel ItemSpacing="32" LineSpacing="20" Margin="0,12,0,0">

            <!-- 1 — the Enabled / Disabled choice. -->
            <StackPanel Width="240" VerticalAlignment="Top">
                <TextBlock Text="tilt" Classes="Display section" />
                <c:Section Margin="0,12,0,0" HorizontalAlignment="Left" Width="240">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="12" IsEnabled="{Binding PressureAndTiltAvailable}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <RadioButton Classes="segment" Content="Enabled"
                                             IsChecked="{Binding TiltEnabled, Mode=OneWay}"
                                             Command="{Binding TurnTiltOnCommand}" />
                                <RadioButton Classes="segment" Content="Disabled"
                                             IsChecked="{Binding DisableTilt, Mode=OneWay}"
                                             Command="{Binding TurnTiltOffCommand}" />
                            </StackPanel>
                            <StackPanel Spacing="3" IsVisible="{Binding TiltEnabled}">
                                <TextBlock Text="Sent to apps" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Apps receive the angle the pen is held at." TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="3" IsVisible="{Binding DisableTilt}">
                                <TextBlock Text="Not sent" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Apps receive no tilt from this tablet." TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Tilt is off while the pen presses like a mouse."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding PressesLikeMouse}" />
                    </StackPanel>
                </c:Section>
            </StackPanel>

            <!-- 2 and 3 — the pen's tilt, live from the tablet's own reports (before the output stage, so they
                 move even with tilt disabled): which way it leans, seen from above, and how far it is tipped
                 over, seen from the side. The stream runs while this tab is showing (PenDetailView). -->
            <StackPanel Width="260" VerticalAlignment="Top">
                <TextBlock Text="azimuth" Classes="Display section" />
                <TextBlock Text="Which way the pen leans, seen from above." TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <c:Section Padding="12,10" Margin="0,12,0,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <c:TiltAzimuthDiagram Azimuth="{Binding LiveAzimuth}" Altitude="{Binding LiveAltitude}"
                                              TrackBrush="{DynamicResource TextMutedBrush}"
                                              LabelBrush="{DynamicResource TextMutedBrush}"
                                              PenBrush="{DynamicResource TextPrimaryBrush}"
                                              AccentBrush="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding LiveAzimuthText}" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </c:Section>
            </StackPanel>

            <StackPanel Width="260" VerticalAlignment="Top">
                <TextBlock Text="altitude" Classes="Display section" />
                <TextBlock Text="How far the pen is tipped over, seen from the side." TextWrapping="Wrap"
                           Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                <c:Section Padding="12,10" Margin="0,12,0,0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <c:TiltAltitudeDiagram Altitude="{Binding LiveAltitude}"
                                               TrackBrush="{DynamicResource TextMutedBrush}"
                                               LabelBrush="{DynamicResource TextMutedBrush}"
                                               PenBrush="{DynamicResource TextPrimaryBrush}"
                                               AccentBrush="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding LiveAltitudeText}" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </c:Section>
            </StackPanel>

            </WrapPanel>
        </ScrollViewer>

        <!-- BUTTONS — the barrel buttons: the pen across the top with its buttons numbered from the tip, and one
             card per button underneath, each with its three choices in view (PenButtonsView, #1015). It replaced a
             240px column of one-line cards beside a standing pen, which left most of the page empty. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #ButtonsTab.IsChecked}">
            <views:PenButtonsView Margin="0,12,0,0" />
        </ScrollViewer>

        <!-- PRESSURE — the pressure curve + pressure smoothing (moved from the tablet page,
             #pen-dynamics-move). Shared DynamicsView, same control the focused Pen Dynamics editor hosts.
             Position smoothing now lives on the movement tab above. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #DynamicsTab.IsChecked}">
            <views:DynamicsView />
        </ScrollViewer>
    </Grid>
</UserControl>
