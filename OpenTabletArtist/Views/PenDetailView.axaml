<UserControl x:Class="OpenTabletArtist.Views.PenDetailView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:OpenTabletArtist.Controls"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:otac="using:OpenTabletArtist.Converters"
             xmlns:views="using:OpenTabletArtist.Views">

    <!-- The switcher/detection statusDot + statusSquare styles moved into TabletSwitcherBar (#580). -->

    <!-- A single tablet's PEN settings (#pen-split), DataContext is a TabletDetailViewModel (shared with the
         tablet page). Same toolbar structure as the tablet page: switcher · pivots · D/R/F, over the
         pivot-gated content. Only ever embedded in the PEN page, so the switcher/actions always show. -->
    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar row: switcher · pivots (basics · inputs · pressure) · compact actions (D · R · F). -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Margin="0,0,0,14" Padding="0,0,0,7">
            <!-- Pivots only; the switcher moved to the shell top bar (#switcher-in-shell). -->
            <Grid>
                <!-- Pivots — the pen's sub-sections. RadioButtons switched by ElementName; content gates on
                     #XTab.IsChecked. "basics" is the whole pen — switches, diagram, inputs and movement
                     (#pen-merge); it absorbed the old "inputs" tab, which had already absorbed "buttons". -->
                <WrapPanel Orientation="Horizontal" x:Name="TabRail" VerticalAlignment="Center">
                    <RadioButton Content="basics" IsChecked="True" x:Name="MovementTab"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                    <!-- The pressure tab (formerly "dynamics") — pressure curve + pressure smoothing. Moved
                         here from the tablet page (#pen-dynamics-move); x:Name kept for the code-behind. -->
                    <RadioButton Content="pressure" x:Name="DynamicsTab"
                                 Theme="{StaticResource PivotTab}" Margin="0,1,26,1" />
                </WrapPanel>

            </Grid>
        </Border>

        <!-- BASICS — the whole pen in one view (#pen-merge). Four columns:
               1  the physical switches — tip, eraser, then barrel buttons 3-2-1
               2  the pen diagram, whose lit buttons line up with the cards beside it
               3  how the pen moves and presses, plus position smoothing
               4  the pen-input opt-outs

             This was two tabs, "basics" and "inputs". They described one object between them, and the
             split meant you could not see which barrel button did what while changing how the pen
             presses — the two things most often set together.

             Column 3 is the star one: the smoothing slider needs a definite width to render its track,
             since a size-to-content Slider collapses it to nothing. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #MovementTab.IsChecked}">
            <Grid ColumnDefinitions="Auto,32,Auto,32,*,32,Auto" Margin="0,12,0,0">

                <!-- 1 — the switches. Buttons run 3-2-1 top-to-bottom so they read against the diagram
                     beside them: button 1 sits nearest the tip, at the bottom. -->
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                    <views:PenSwitchCard DataContext="{Binding PenTipRow}" />
                    <views:PenSwitchCard DataContext="{Binding PenEraserRow}" />
                    <views:PenSwitchCard DataContext="{Binding PenButton3Row}"
                                         IsVisible="{Binding $parent[StackPanel].DataContext.PenButton3Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <views:PenSwitchCard DataContext="{Binding PenButton2Row}"
                                         IsVisible="{Binding $parent[StackPanel].DataContext.PenButton2Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <views:PenSwitchCard DataContext="{Binding PenButton1Row}"
                                         IsVisible="{Binding $parent[StackPanel].DataContext.PenButton1Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <LayoutTransformControl Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </LayoutTransformControl.LayoutTransform>
                <Viewbox MaxWidth="440" MaxHeight="86">
                    <Canvas Width="400" Height="80">
                        <Rectangle Canvas.Left="342" Canvas.Top="31" Width="26" Height="18" RadiusX="6" RadiusY="6"
                                   Fill="{DynamicResource PenDiagramFillBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="14" Canvas.Top="36" Width="20" Height="8" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource PenDiagramFillBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5" />
                        <Polygon Points="72,28 72,52 26,45 26,35" Fill="{DynamicResource PenDiagramFillBrush}"
                                 Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5" StrokeJoin="Round" />
                        <Rectangle Canvas.Left="70" Canvas.Top="28" Width="287" Height="24"
                                   Fill="{DynamicResource PenDiagramFillBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="97" Canvas.Top="32" Width="25" Height="16" RadiusX="6" RadiusY="6"
                                   Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5"
                                   IsVisible="{Binding PenButton1Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <Rectangle Canvas.Left="131" Canvas.Top="32" Width="25" Height="16" RadiusX="6" RadiusY="6"
                                   Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5"
                                   IsVisible="{Binding PenButton2Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <Rectangle Canvas.Left="165" Canvas.Top="32" Width="25" Height="16" RadiusX="6" RadiusY="6"
                                   Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PenDiagramStrokeBrush}" StrokeThickness="1.5"
                                   IsVisible="{Binding PenButton3Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <!-- Button numbers, centred on each side button so the diagram maps 1:1 to the
                             "Button N" cards on the right. Counter-rotated +90° (about the default centre
                             RenderTransformOrigin) to stay upright against the pen's -90° stand. -->
                        <Border Canvas.Left="97" Canvas.Top="32" Width="25" Height="16" Background="Transparent"
                                IsVisible="{Binding PenButton1Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <Border.RenderTransform><RotateTransform Angle="90" /></Border.RenderTransform>
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Canvas.Left="131" Canvas.Top="32" Width="25" Height="16" Background="Transparent"
                                IsVisible="{Binding PenButton2Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <Border.RenderTransform><RotateTransform Angle="90" /></Border.RenderTransform>
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Canvas.Left="165" Canvas.Top="32" Width="25" Height="16" Background="Transparent"
                                IsVisible="{Binding PenButton3Row, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <Border.RenderTransform><RotateTransform Angle="90" /></Border.RenderTransform>
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Canvas>
                </Viewbox>
                </LayoutTransformControl>

                <!-- 4 — the pen-input opt-outs. -->
                <c:Section Grid.Column="6" Width="240" HorizontalAlignment="Left">
                    <StackPanel Spacing="10">
                        <TextBlock Text="pen input" Classes="Display section" />
                        <ctrl:ToggleSetting Label="Disable pen tip" InlineDescription="True"
                                            IsChecked="{Binding DisablePenTip}" />
                        <!-- Disable pressure sensitivity (#494): a flat on/off contact that drops
                             pressure entirely (the Pen Dynamics curve is then inert). Moved here from
                             the Dynamics tab. -->
                        <ctrl:ToggleSetting Label="Disable pressure sensitivity" InlineDescription="True"
                                            IsChecked="{Binding DisablePressure}" />
                        <!-- Disable tilt (#494): apps receive no tilt from this tablet. Moved here from
                             the Dynamics tab so all pen-input opt-outs live together. -->
                        <ctrl:ToggleSetting Label="Disable tilt" InlineDescription="True"
                                            IsChecked="{Binding DisableTilt}" />
                        <!-- Drag bindings hidden for now (#492); the binding + apply wiring stays. -->
                        <ctrl:ToggleSetting Label="Drag bindings" IsVisible="False"
                                            Description="Pen button bindings only work while the pen is touching the tablet (drag-only), not while hovering."
                                            IsChecked="{Binding DragBindingsEnabled}" />
                    </StackPanel>
                </c:Section>

                <!-- 3 — movement, then pressing, then position smoothing. -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="movement" Classes="Display section" />

                    <!-- IsChecked is OneWay (display only); the mode change is driven by the Command on click.
                         A TwoWay IsChecked here made the two grouped radios fight into an apply↔reload loop.

                         The option labels are plain body text. They used to carry CardTitle — TypeTitleSize,
                         a step above everything around them — which made a radio's label the largest text on
                         the page after the headings, larger than the settings it was describing. Every other
                         checkbox and radio label in the app (ToggleSetting) is body size, with a MUTED
                         description under it; these match that now. -->
                    <StackPanel Margin="0,12,0,0" Spacing="10">
                        <RadioButton GroupName="Movement"
                                     IsChecked="{Binding IsAbsoluteMode, Mode=OneWay}"
                                     Command="{Binding SelectMovementCommand}" CommandParameter="absolute">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Normal (Absolute)" />
                                <TextBlock Text="The pen maps 1:1 to the screen — good for artists."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Movement"
                                     IsChecked="{Binding IsAbsoluteMode, Converter={StaticResource InvBool}, Mode=OneWay}"
                                     Command="{Binding SelectMovementCommand}" CommandParameter="relative">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Mouse-like (Relative)" />
                                <TextBlock Text="The pen moves the cursor like a mouse — often used with games."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Only when the current mode isn't Windows Ink: pressure/tilt won't work; offer a fix. -->
                    <TextBlock Text="Output mode needs to use Windows Ink for pressure and tilt to work"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontStyle="Italic" Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               IsVisible="{Binding CanFixOutputMode}" />
                    <Button Content="Fix" Theme="{StaticResource AccentButton}"
                            Command="{Binding FixOutputModeCommand}"
                            Padding="12,6" Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CanFixOutputMode}" />

                    <StackPanel IsVisible="{Binding CanDisableWindowsInk}">
                        <TextBlock Text="pressing" Classes="Display section" />
                        <StackPanel Margin="0,12,0,0" Spacing="10">
                            <RadioButton GroupName="PressMode"
                                         IsChecked="{Binding DisableWindowsInk, Converter={StaticResource InvBool}, Mode=OneWay}"
                                         Command="{Binding SelectPressModeCommand}" CommandParameter="pen">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Presses normally" TextWrapping="Wrap" />
                                    <TextBlock Text="Works like an artist would expect, with pressure sensitivity and tilt"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="PressMode"
                                         IsChecked="{Binding DisableWindowsInk, Mode=OneWay}"
                                         Command="{Binding SelectPressModeCommand}" CommandParameter="mouse">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Presses like a mouse" TextWrapping="Wrap" />
                                    <TextBlock Text="No pressure sensitivity or tilt" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- Position smoothing (EMA), moved here from the Pressure tab: it steadies the pen's
                         on-screen position, so it belongs with movement. Capped at 0.25 (#487): heavier is
                         too laggy to be useful. Sits last in the column, under pressing.
                         One top margin, not two: this used to be a single-child StackPanel carrying
                         Margin="0,28,0,0" around a slider carrying another "0,8,0,0", which opened a 36px
                         gap under the radios that nothing else in the column came close to. The wrapper
                         did nothing else — a LabeledSlider stretches to the column width on its own. -->
                    <ctrl:LabeledSlider Label="Position smoothing" LabelWidth="130" Margin="0,20,0,0"
                                        Minimum="0" Maximum="{Binding PositionSmoothingMax}"
                                        Ticks="0,0.05,0.1,0.15,0.2,0.25" TickPlacement="BottomRight"
                                        Value="{Binding PositionSmoothing}"
                                        ValueTextOverride="{Binding PositionSmoothingText}"
                                        Monospace="True" ValueWidth="44"
                                        ToolTip.Tip="EMA smoothing of the pen position — steadies wobbly lines, at a little lag." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- PRESSURE — the pressure curve + pressure smoothing (moved from the tablet page,
             #pen-dynamics-move). Shared DynamicsView, same control the focused Pen Dynamics editor hosts.
             Position smoothing now lives on the movement tab above. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding #DynamicsTab.IsChecked}">
            <views:DynamicsView />
        </ScrollViewer>
    </Grid>
</UserControl>
