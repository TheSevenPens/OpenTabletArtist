<UserControl x:Class="OpenTabletArtist.Views.PluginsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- DataContext is the PluginsViewModel, supplied by the typed-nav DataTemplate (#15).

         Two columns: the installed-plugin list on the left, the Windows Ink section on the right. Windows
         Ink used to sit under DRIVERS beside the VMulti driver, but it installs and manages a PLUGIN — so
         it belongs next to the list of them (#winink-to-plugins). -->
    <Grid ColumnDefinitions="*,32,*" MaxWidth="1040" HorizontalAlignment="Left">

        <StackPanel Grid.Column="0">
        <!-- Header card: title + rescan/browse actions. -->
        <c:Section>
            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Text="installed plugins" Classes="Display section"
                           VerticalAlignment="Center" />
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <c:IconButton Icon="{StaticResource IconRefresh}"
                                  Command="{Binding RefreshCommand}"
                                  ToolTip.Tip="Rescan the plugin folder"
                                  AutomationProperties.Name="Rescan the plugin folder"
                                  Margin="0,0,6,4" />
                    <c:IconButton Icon="{StaticResource IconFolderOutline}"
                                  Command="{Binding BrowseCommand}"
                                  ToolTip.Tip="Open the plugin folder in File Explorer"
                                  AutomationProperties.Name="Open the plugin folder in File Explorer"
                                  Margin="0,0,0,4" />
                </WrapPanel>
            </Grid>
        </c:Section>

        <!-- Empty state -->
        <TextBlock Text="{Binding EmptyMessage}" FontStyle="Italic"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                   IsVisible="{Binding !HasPlugins}" />

        <!-- One card per installed plugin: name/version, with an Active/Installed badge. -->
        <ItemsControl ItemsSource="{Binding Plugins}" IsVisible="{Binding HasPlugins}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Entity>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Version}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding Version, Converter={StaticResource NonEmptyToBool}}" />
                            </StackPanel>
                            <c:Chip Grid.Column="1" Text="{Binding Status}" Kind="Accent" />
                        </Grid>
                    </c:Entity>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <!-- Hidden off Windows, where the VM is null: nothing inside WindowsInkView guards the OS itself —
             it relied on the DRIVERS pivot being filtered out, and PLUGINS is not. -->
        <ContentControl Grid.Column="2" VerticalAlignment="Top"
                        Content="{Binding WindowsInk}"
                        IsVisible="{Binding HasWindowsInk}" />
    </Grid>
</UserControl>
