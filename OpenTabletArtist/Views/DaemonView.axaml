<UserControl x:Class="OpenTabletArtist.Views.DaemonView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- DataContext is the DaemonViewModel, supplied by the typed-nav DataTemplate (#15). Two columns:
         left holds the daemon connection + process cards; right stacks the system-package card (Linux) and
         the bundled-version card. Columns are top-aligned so the shorter right column doesn't stretch. -->

    <!-- Every daemon fact reads as one consistent "property: value" list (#daemon-proplist): a muted,
         bulleted label in the Auto column and its value in the * column, so values align down each card.
         State is carried by the value text alone — no status dots, and no colour (so it reads the same
         under every skin, incl. Sakura). Live numbers / versions / paths use the app's monospace font. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.propValue">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.propValue.mono">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
        </Style>
        <!-- Paths: same monospace, a step smaller + muted, since they're long and secondary. -->
        <Style Selector="TextBlock.propValue.path">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="28" MaxWidth="1200" HorizontalAlignment="Left">

        <!-- LEFT COLUMN: DAEMON CONNECTION on top, then DAEMON PROCESS. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">

            <!-- DAEMON CONNECTION (#daemon-overhaul): whether OTA is connected to a daemon and for how long
                 (measured from when OTA attached — not the daemon's own uptime, which is the PROCESS card).
                 Bound to the connection sub-VM; Refresh comes from the shared status VM. -->
            <c:Section DataContext="{Binding Connection}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" MinWidth="0">
                            <TextBlock Classes="SectionLabel" Text="DAEMON CONNECTION" TextWrapping="Wrap" />

                            <!-- property: value list -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto"
                                  Margin="0,2,0,0">
                                <!-- Status: Connected / Not connected -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="•  Status:" />
                                <Panel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Classes="propValue" Text="Connected"
                                               IsVisible="{Binding Status.IsConnected}" />
                                    <TextBlock Classes="propValue" Text="Not connected"
                                               IsVisible="{Binding !Status.IsConnected}" />
                                </Panel>

                                <!-- Connection age (from when OTA attached) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="•  Connected since:"
                                           IsVisible="{Binding ShowConnectionTiming}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="propValue mono"
                                           Text="{Binding ConnectedSince}" IsVisible="{Binding ShowConnectionTiming}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="•  Up for:"
                                           IsVisible="{Binding ShowConnectionTiming}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="propValue mono"
                                           Text="{Binding ConnectedDuration}" IsVisible="{Binding ShowConnectionTiming}" />
                            </Grid>
                        </StackPanel>

                        <!-- REFRESH (reconnect / reload) -->
                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                            <c:IconButton Icon="{StaticResource IconRefresh}"
                                          Command="{Binding Status.RefreshCommand}"
                                          ToolTip.Tip="Check daemon status"
                                          AutomationProperties.Name="Check daemon status"
                                          IsEnabled="{Binding !Status.IsDaemonBusy}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Auto-connect ran past the timeout: it's still retrying in the background, so say so
                         (with an immediate Retry) rather than a silent "Not connected". (#296) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0"
                          IsVisible="{Binding Status.ConnectStalled}">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Couldn't reach the daemon — still retrying in the background." />
                        <Button Grid.Column="1" Content="Retry" Command="{Binding Status.RefreshCommand}"
                                Theme="{StaticResource AccentButton}" Padding="12,6"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </c:Section>

            <!-- DAEMON PROCESS (#daemon-overhaul): whether a daemon process is running, which one it is
                 (ownership + path), its version + whether that matches OTA's build, and its process uptime.
                 Process facts come from a direct process lookup (accurate even when not connected). Bound to
                 the process sub-VM; Refresh/Start/Restart/Stop come from the shared status VM. -->
            <c:Section DataContext="{Binding Process}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" MinWidth="0">
                            <TextBlock Classes="SectionLabel" Text="DAEMON PROCESS" TextWrapping="Wrap" />

                            <!-- property: value list -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                <!-- Status: Running / Not running -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="•  Status:" />
                                <Panel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Classes="propValue" Text="Running" IsVisible="{Binding IsRunning}" />
                                    <TextBlock Classes="propValue" Text="Not running" IsVisible="{Binding !IsRunning}" />
                                </Panel>

                                <!-- Source: bundled (ships with OTA) or an external daemon OTA didn't start -->
                                <Panel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Classes="propLabel" Text="•  Source:"
                                               IsVisible="{Binding Status.ShowAppOwnedDaemon}" />
                                    <TextBlock Classes="propLabel" Text="•  Source:"
                                               IsVisible="{Binding Status.ShowForeignDaemonWarning}" />
                                </Panel>
                                <Panel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Classes="propValue" Text="Bundled (ships with OTA)"
                                               IsVisible="{Binding Status.ShowAppOwnedDaemon}" />
                                    <TextBlock Classes="propValue" Text="External (not started by OTA)"
                                               IsVisible="{Binding Status.ShowForeignDaemonWarning}" />
                                </Panel>

                                <!-- Version of the connected daemon -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="•  Version:"
                                           IsVisible="{Binding Status.HasDaemonVersion}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="propValue mono"
                                           Text="{Binding Status.DaemonVersion, StringFormat='v{0}'}"
                                           IsVisible="{Binding Status.HasDaemonVersion}" />

                                <!-- Build match vs the version OTA was built with -->
                                <Panel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Classes="propLabel" Text="•  Build match:"
                                               IsVisible="{Binding ShowVersionMatch}" />
                                    <TextBlock Classes="propLabel" Text="•  Build match:"
                                               IsVisible="{Binding ShowVersionMismatch}" />
                                </Panel>
                                <Panel Grid.Row="3" Grid.Column="1">
                                    <TextBlock Classes="propValue" Text="Matches OTA build"
                                               IsVisible="{Binding ShowVersionMatch}" />
                                    <TextBlock Classes="propValue"
                                               Text="{Binding BuiltAgainstVersion, StringFormat='Differs from OTA build (built against v{0})'}"
                                               IsVisible="{Binding ShowVersionMismatch}" />
                                </Panel>

                                <!-- Process uptime (the daemon's own run time) -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="propLabel" Text="•  Uptime:"
                                           IsVisible="{Binding ShowProcessUptime}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="propValue mono"
                                           Text="{Binding ProcessUptime}" IsVisible="{Binding ShowProcessUptime}" />
                            </Grid>
                        </StackPanel>

                        <!-- REFRESH / START / RESTART / STOP -->
                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                            <c:IconButton Icon="{StaticResource IconRefresh}"
                                          Command="{Binding Status.RefreshCommand}"
                                          ToolTip.Tip="Check daemon status"
                                          AutomationProperties.Name="Check daemon status"
                                          IsEnabled="{Binding !Status.IsDaemonBusy}"
                                          Margin="0,0,6,0" />
                            <!-- Start: shown when not connected and not mid-connect -->
                            <Button Content="Start" Theme="{StaticResource AccentButton}"
                                    Command="{Binding Status.StartDaemonCommand}"
                                    IsVisible="{Binding Status.ShowStartButton}"
                                    IsEnabled="{Binding !Status.IsDaemonBusy}"
                                    Padding="12,6" />
                            <!-- Restart: shown when connected -->
                            <Button Content="Restart" Theme="{StaticResource AccentButton}"
                                    Command="{Binding Status.RestartDaemonCommand}"
                                    IsVisible="{Binding Status.IsConnected}"
                                    IsEnabled="{Binding !Status.IsDaemonBusy}"
                                    Padding="12,6" />
                            <!-- Stop: shown when connected -->
                            <Button Content="Stop" Theme="{StaticResource DeleteButton}"
                                    Command="{Binding Status.StopDaemonCommand}"
                                    IsVisible="{Binding Status.IsConnected}"
                                    IsEnabled="{Binding !Status.IsDaemonBusy}"
                                    Padding="12,6" Margin="6,0,0,0" />
                        </WrapPanel>
                    </Grid>

                    <!-- Activity: indeterminate progress + phase text while a lifecycle op runs OR while the
                         initial connect is in flight. -->
                    <StackPanel IsVisible="{Binding Status.ShowDaemonActivity}" Margin="0,12,0,0">
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                                     Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Status.DaemonActivityText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Error: shown when a lifecycle op times out or fails -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                IsVisible="{Binding Status.HasDaemonOperationError}">
                        <TextBlock Classes="warning" />
                        <TextBlock Text="{Binding Status.DaemonOperationError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </c:Section>
        </StackPanel>

        <!-- RIGHT COLUMN: the external-daemon card (when applicable), system-package state (Linux), and the
             bundled daemon version. -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">

            <!-- EXTERNAL DAEMON (#591): OTA connects to whatever daemon is already running — including an
                 officially-installed / separately-started OpenTabletDriver — and only launches its own
                 bundled copy when nothing is running. When the connected daemon isn't OTA's build, present
                 that here as a supported setup (path + version), with a one-click switch back to bundled. -->
            <c:Section Margin="0,0,0,12" IsVisible="{Binding Status.ShowForeignDaemonWarning}">
                <StackPanel>
                    <TextBlock Classes="SectionLabel" Text="EXTERNAL DAEMON" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="OTA is connected to a daemon it didn't start — for example an officially-installed OpenTabletDriver. This is supported: OTA configures whichever daemon is running, and only starts its own bundled copy when none is." />

                    <!-- property: value list -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="•  Path:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="propValue path"
                                   Text="{Binding Status.DaemonSourcePath}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="•  Version:"
                                   IsVisible="{Binding Status.HasDaemonVersion}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="propValue mono"
                                   Text="{Binding Status.DaemonVersion, StringFormat='v{0}'}"
                                   IsVisible="{Binding Status.HasDaemonVersion}" />
                    </Grid>

                    <!-- Didn't mean to use it? Restart stops the external daemon and launches OTA's bundled build. -->
                    <Button Content="Use bundled daemon instead" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding Status.RestartDaemonCommand}"
                            IsEnabled="{Binding !Status.IsDaemonBusy}"
                            Theme="{StaticResource GhostButton}" Padding="12,6"
                            ToolTip.Tip="Stop the external daemon and start OTA's own bundled build" />
                </StackPanel>
            </c:Section>

            <!-- Linux only: is OTD installed as a system RPM package (the normal Fedora/RHEL install), or is
                 it running from source / a tarball? Checked on-demand (tab entry + the Refresh button). -->
            <c:Section Margin="0,0,0,12" IsVisible="{Binding IsLinux}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" MinWidth="0">
                            <TextBlock Classes="SectionLabel" Text="SYSTEM-INSTALLED DAEMON" TextWrapping="Wrap" />

                            <!-- property: value list -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"
                                  RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                                <!-- Package: installed via RPM (+ version) or running from source/tarball -->
                                <Panel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Classes="propLabel" Text="•  Package:"
                                               IsVisible="{Binding OtdPackageInstalled}" />
                                    <TextBlock Classes="propLabel" Text="•  Package:"
                                               IsVisible="{Binding ShowOtdPackageMissing}" />
                                </Panel>
                                <Panel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Classes="propValue"
                                               Text="{Binding OtdPackageVersion, StringFormat='Installed (RPM) — v{0}'}"
                                               IsVisible="{Binding OtdPackageInstalled}"
                                               ToolTip.Tip="OpenTabletDriver is installed via your package manager (rpm -q opentabletdriver)" />
                                    <TextBlock Classes="propValue"
                                               Text="Not installed (running from source / tarball)"
                                               IsVisible="{Binding ShowOtdPackageMissing}"
                                               ToolTip.Tip="No 'opentabletdriver' RPM package is installed (rpm -q opentabletdriver)" />
                                </Panel>

                                <!-- Packaged daemon binary path -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="•  Path:"
                                           IsVisible="{Binding HasOtdDaemonPath}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="propValue path"
                                           Text="{Binding OtdDaemonPath}" IsVisible="{Binding HasOtdDaemonPath}" />

                                <!-- Service running -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="•  Service:"
                                           IsVisible="{Binding OtdServiceActive}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="propValue"
                                           Text="Running (opentabletdriver.service)"
                                           IsVisible="{Binding OtdServiceActive}" />
                            </Grid>

                            <!-- Start the packaged systemd user service (shown when installed but not running) -->
                            <Button Content="Start OpenTabletDriver service" Margin="0,10,0,0"
                                    Command="{Binding StartOtdServiceCommand}"
                                    IsVisible="{Binding ShowStartOtdService}"
                                    Theme="{StaticResource AccentButton}" Padding="12,6"
                                    HorizontalAlignment="Left" />

                            <!-- Result of the last Start action -->
                            <TextBlock Text="{Binding OtdServiceStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding HasOtdServiceStatus}" />
                        </StackPanel>

                        <!-- Refresh: re-run the package check on demand. -->
                        <c:IconButton Grid.Column="1" Icon="{StaticResource IconRefresh}"
                                      Command="{Binding CheckOtdPackageCommand}"
                                      ToolTip.Tip="Re-check whether OTD is installed as a system package"
                                      AutomationProperties.Name="Re-check system package"
                                      VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </c:Section>

            <!-- Embedded OpenTabletDriver Version (moved here from Home). -->
            <c:Section>
                <StackPanel MinWidth="0">
                    <TextBlock Classes="SectionLabel" Text="BUNDLED DAEMON" TextWrapping="Wrap" />

                    <!-- property: value list -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="propLabel" Text="•  Version:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="propValue mono"
                                   Text="{Binding CurrentOtdVersion, StringFormat='v{0}'}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="•  Path:"
                                   IsVisible="{Binding HasBundledDaemonPath}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="propValue path"
                                   Text="{Binding BundledDaemonPath}" IsVisible="{Binding HasBundledDaemonPath}" />
                    </Grid>
                </StackPanel>
            </c:Section>

            <!-- OTD UX: launch OpenTabletDriver's own interface (comparison / settings OTA doesn't surface).
                 A pure action card (no properties), so it keeps its description + button. Hidden unless the
                 UX is actually launchable — only a development tree has its sources. -->
            <c:Section Margin="0,12,0,0" IsVisible="{Binding Status.CanLaunchOtdUx}">
                <StackPanel>
                    <TextBlock Classes="SectionLabel" Text="OTD UX" TextWrapping="Wrap" />
                    <TextBlock Text="Open OpenTabletDriver's own interface — for comparison, or for settings OTA doesn't surface."
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="LAUNCH OTD UI" Theme="{StaticResource GhostButton}"
                            Command="{Binding Status.LaunchOtdUxCommand}"
                            HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" />
                </StackPanel>
            </c:Section>
        </StackPanel>
    </Grid>
</UserControl>
