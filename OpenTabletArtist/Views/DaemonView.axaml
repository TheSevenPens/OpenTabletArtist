<UserControl x:Class="OpenTabletArtist.Views.DaemonView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:conv="using:OpenTabletArtist.Converters">

    <!-- DataContext is the DaemonViewModel, supplied by the typed-nav DataTemplate (#15).

         The page is plain status (#1043). It used to lead with a diagram, this app on the left and the
         daemon on the right with a wire between them, and the diagram did not work: it made a handful of
         facts hard to find by drawing them as a picture. What replaced it is a list, one fact per line,
         in the order a person checks them.

         A daemon the app declined to attach to (#1042) leads the page, above everything else, with the
         button that gets out of it. The window of OpenTabletDriver itself has a button that is always
         there; if the window cannot be found, pressing it says where it looked. -->

    <!-- Every daemon fact reads as one consistent property/value pair (#daemon-proplist): a muted label
         in the Auto column and its value in the * column, so values align down each block. State is
         carried by the value text alone — no status dots, and no color (so it reads the same under every
         skin, incl. Sakura). Live numbers and versions use the app's monospace font.

         A daemon PATH is the exception: an absolute path wrapped over three lines and dwarfed every fact
         around it, so the value is a folder button now and the path itself moved to its tooltip
         (#daemon-path-button). -->
    <UserControl.Styles>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.propValue">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A mono value needs a nudge DOWN to share its label's baseline (#daemon-proplist-baseline).
             Both TextBlocks are arranged at the top of the same grid row, and each draws its text one
             font-ascent below that top — so the face with the shorter ascent sits higher. Consolas
             asks for roughly 0.80 em against the UI face's ~1.08, which at 13 px is the 4 px below.
             LineHeight does not help: it sizes the line box without moving the baseline inside it.

             4 is measured, not guessed: screen-grab the page, find the last inked row of the label and
             of the value, and difference them. At 6 (no compensation) the value ran 6-7 device px high
             on a 150%-scaled display; at 10 the pairs land within half a pixel.

             The number is a metric of these two faces, so it has to be re-checked if either changes —
             in particular by #718, where the UI font is meant to become Inter and currently is not. -->
        <Style Selector="TextBlock.propValue.mono">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- The path reads as text, not as a control; the whole line is the hit target. -->
        <Style Selector="Button.pathLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pathLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.pathLink:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.pathText">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeDetailSize}" />
        </Style>
    </UserControl.Styles>

    <StackPanel>

        <!-- ── A DAEMON THE APP WON'T ATTACH TO (#1042) ────────────────────────────────
             Leads the page, because it is the reason nothing else here works. Names what is running, what
             this version needs, and what to do, and the button does it — after the same confirmation any
             stop of a daemon this app didn't start asks for. Nothing is stopped until it is pressed. -->
        <c:Alert Severity="Error" Margin="0,0,0,18" Padding="16,13" MaxWidth="900" HorizontalAlignment="Left"
                 IsVisible="{Binding Status.IsDaemonRefused}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Grid.Column="0" Data="{StaticResource IconAlertCircle}" Width="22" Height="22"
                          VerticalAlignment="Top" Margin="0,1,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Top">
                    <TextBlock Text="OpenTabletArtist isn't connected" Classes="CardTitle" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status.DaemonRefusalReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Stop this daemon" VerticalAlignment="Center"
                        Command="{Binding Status.StopDaemonCommand}"
                        IsEnabled="{Binding !Status.IsDaemonBusy}"
                        Theme="{StaticResource AccentButton}" Padding="14,8"
                        ToolTip.Tip="Asks first, then stops the OpenTabletDriver that is running. Start the one OpenTabletArtist ships with afterwards." />
            </Grid>
        </c:Alert>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28">
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <c:Section Width="420" VerticalAlignment="Top">
                <StackPanel>

                    <!-- The two things you do from here: open OpenTabletDriver's own window, and act on the
                         daemon. The first is a button because it is the thing people come to this page for;
                         the second is a menu because Start, Restart and Stop are each shown on their own
                         condition and a row of them would mostly be hidden. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="Display section" Text="daemon" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Open OpenTabletDriver" VerticalAlignment="Center"
                                Command="{Binding OpenOtdUxCommand}"
                                Theme="{StaticResource AccentButton}" Padding="14,8"
                                ToolTip.Tip="Opens OpenTabletDriver's own window. It edits the same driver, so changes made there will pause OpenTabletArtist until you reload." />
                        <c:IconButton Grid.Column="2" VerticalAlignment="Center"
                                      Icon="{StaticResource IconDotsHorizontal}"
                                      ToolTip.Tip="Daemon actions"
                                      AutomationProperties.Name="Daemon actions">
                            <c:IconButton.Flyout>
                                <MenuFlyout>
                                    <!-- The header follows what pressing it will do: "Refresh status"
                                         connected, where it reloads settings without reopening the
                                         connection, and "Reconnect" disconnected, where it opens one. A
                                         single name described only one of the two (#912, #949). -->
                                    <MenuItem Header="{Binding Status.RefreshActionLabel}"
                                              Command="{Binding Status.RefreshCommand}"
                                              IsEnabled="{Binding !Status.IsDaemonBusy}" />
                                    <Separator />
                                    <MenuItem Header="Start"
                                              Command="{Binding Status.StartDaemonCommand}"
                                              IsVisible="{Binding Status.ShowStartButton}"
                                              IsEnabled="{Binding !Status.IsDaemonBusy}" />
                                    <MenuItem Header="Restart"
                                              Command="{Binding Status.RestartDaemonCommand}"
                                              IsVisible="{Binding Status.IsConnected}"
                                              IsEnabled="{Binding !Status.IsDaemonBusy}" />
                                    <MenuItem Header="Stop"
                                              Command="{Binding Status.StopDaemonCommand}"
                                              IsVisible="{Binding Status.IsConnected}"
                                              IsEnabled="{Binding !Status.IsDaemonBusy}"
                                              Foreground="{DynamicResource ErrorBrush}" />
                                    <!-- A development tree can run OpenTabletDriver's window from source. -->
                                    <Separator IsVisible="{Binding Status.CanLaunchOtdUx}" />
                                    <MenuItem Header="Open OpenTabletDriver (dev build)"
                                              Command="{Binding Status.LaunchOtdUxCommand}"
                                              IsVisible="{Binding Status.CanLaunchOtdUx}" />
                                </MenuFlyout>
                            </c:IconButton.Flyout>
                        </c:IconButton>
                    </Grid>

                    <!-- THE STATUS, one fact per line. A line is there only when it has something to say,
                         so a daemon that is not running reads as one line, not a column of blanks. -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" Margin="0,8,0,0">
                        <TextBlock Classes="propLabel" Text="Status" />
                        <TextBlock Grid.Column="1" Classes="propValue" Text="{Binding StatusText}" />
                    </Grid>

                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" IsVisible="{Binding HasOwnerText}">
                        <TextBlock Classes="propLabel" Text="Daemon" />
                        <TextBlock Grid.Column="1" Classes="propValue" Text="{Binding OwnerText}" />
                    </Grid>

                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" IsVisible="{Binding Status.HasDaemonVersion}">
                        <TextBlock Classes="propLabel" Text="Version" />
                        <TextBlock Grid.Column="1" Classes="propValue mono" Text="{Binding Status.DaemonVersion}" />
                    </Grid>

                    <!-- Same release, another revision (#1042): it works, and the page says so. An older one
                         is said more strongly. Nothing here for an exact match. -->
                    <TextBlock Classes="propValue" Text="{Binding Status.DaemonVersionNote}"
                               IsVisible="{Binding Status.HasDaemonVersionNote}" />

                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" IsVisible="{Binding Process.ShowProcessUptime}">
                        <TextBlock Classes="propLabel" Text="Running for" />
                        <TextBlock Grid.Column="1" Classes="propValue mono" Text="{Binding Process.ProcessUptime}" />
                    </Grid>

                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" IsVisible="{Binding Connection.ShowConnectionTiming}">
                        <TextBlock Classes="propLabel" Text="Connection" />
                        <TextBlock Grid.Column="1" Classes="propValue mono" Text="{Binding Connection.ConnectionLine}" />
                    </Grid>

                    <!-- Which OpenTabletDriver this is, named the way a person would: the .app bundle, not the
                         binary four levels inside it. Full path on the tooltip; the button opens the
                         containing folder. -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" IsVisible="{Binding Status.HasDaemonSourcePath}">
                        <TextBlock Classes="propLabel" Text="Location" />
                        <Button Grid.Column="1" Classes="pathLink" Margin="0,6,0,0" Padding="0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenContainingFolderCommand}"
                                CommandParameter="{Binding Status.DaemonSourcePath}"
                                ToolTip.Tip="{Binding Status.DaemonSourcePath}"
                                AutomationProperties.Name="Open the folder holding this daemon">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <PathIcon Data="{StaticResource IconFolderOutline}" Width="13" Height="13"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Classes="pathText" TextWrapping="Wrap"
                                           Text="{Binding Status.DaemonSourceDisplayPath}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- This app's own end of the comparison: its build, and the OTD release it ships with —
                         on one line, because they are read together and never separately. "Bundles" only
                         where a daemon really ships with the app; on macOS nothing does, so the number is
                         what OTA was compiled against, which is a different claim. -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14">
                        <TextBlock Classes="propLabel" Text="This app" />
                        <TextBlock Grid.Column="1" Classes="propValue mono" Text="{Binding BuildLine}" />
                    </Grid>

                    <!-- Auto-connect ran past the timeout: it's still retrying in the background, so say so
                         (with an immediate Retry) rather than a silent "not connected". (#296) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,14,0,0"
                          IsVisible="{Binding Status.ConnectStalled}">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Couldn't reach the daemon — still retrying in the background." />
                        <Button Grid.Column="1" Content="Retry" Command="{Binding Status.RefreshCommand}"
                                Theme="{StaticResource AccentButton}" Padding="12,6"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Error: shown when a lifecycle op times out or fails. -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                IsVisible="{Binding Status.HasDaemonOperationError}">
                        <TextBlock Classes="warning" />
                        <TextBlock Text="{Binding Status.DaemonOperationError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- An edit was discarded because the daemon changed underneath it (#787). Discarding
                         is the right call - the alternative was writing one daemon's settings into
                         another's file - but it is still something the artist did, and the save chip
                         going quiet explains nothing. Shown here rather than as a health issue because it
                         is an event, not a state: it describes something that already happened. -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                IsVisible="{Binding Status.HasDiscardedChangeNotice}">
                        <TextBlock Classes="warning" />
                        <TextBlock Text="{Binding Status.DiscardedChangeNotice}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Missing .NET runtime (#786, D2). OpenTabletDriver's official Windows build is
                         framework-dependent where OTA is self-contained, so a machine with no .NET 10 gets a
                         daemon that exits before printing anything. Offered here, beside the error that
                         explains it, rather than as a health card: this is a prerequisite for connecting,
                         which is what this page is about.

                         The button opens Microsoft's page rather than installing anything. OTA used to do
                         the download and the elevated install itself; watching that on a clean machine
                         (#878) showed a progress display the user could not trust, no way to cancel, and,
                         when OTA was already elevated, a quiet install with no visible sign at all,
                         which reads as a hang. The browser does all of that properly already. -->
                    <StackPanel Margin="0,14,0,0" Spacing="8" IsVisible="{Binding ShowInstallRuntime}">
                        <TextBlock Text="OpenTabletDriver needs the .NET 10 runtime" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding InstallRuntimeDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Get .NET 10 from Microsoft"
                                    Command="{Binding OpenRuntimeDownloadCommand}"
                                    Theme="{StaticResource AccentButton}" Padding="12,6" />
                            <Button Content="Check again"
                                    Command="{Binding RecheckRuntimeCommand}"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Outside the offer above, deliberately: finding the runtime removes the offer, and
                         with it anything drawn inside, at the moment there is finally something to read.
                         This also carries the "still not found" answer, so Check again can never look like
                         a button that did nothing. -->
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="{Binding RuntimeInstallOutcome}"
                               IsVisible="{Binding HasRuntimeInstallOutcome}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </c:Section>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="16">

                <!-- The same issues Home shows for this page, repeated at the top of the column that owns
                     them (#317). No Review button here: on Home it navigates to this page, and from this
                     page it would lead back to where the reader already is. The rows stay clickable. -->
                <ItemsControl ItemsSource="{Binding DaemonIssues}" IsVisible="{Binding HasDaemonIssues}"
                              MaxWidth="440" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:Alert Margin="0,0,0,8" Padding="14,11"
                                     Severity="{Binding Severity, Converter={x:Static conv:HealthSeverityToAlertSeverityConverter.Instance}}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <PathIcon Data="{StaticResource IconAlertCircle}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Broken}" />
                                        <PathIcon Data="{StaticResource IconAlert}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Misconfigured}" />
                                        <PathIcon Data="{StaticResource IconLightbulbOn}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Recommendation}" />
                                        <PathIcon Data="{StaticResource IconInformationOutline}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                  IsVisible="{Binding Severity, Converter={StaticResource EnumEquals}, ConverterParameter=Information}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Title}" Classes="CardTitle" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Links}" Margin="0,6,0,0"
                                                      IsVisible="{Binding Links, Converter={StaticResource NotNull}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                        <TextBlock Text="&#8226;" VerticalAlignment="Top"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </c:Alert>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            <!-- The rest of this column, under the issues above it. Each card is conditional (external
                 daemon, Linux-only package state, dev-only OTD UX), so on a released Windows build with
                 the bundled daemon this area is empty and the page is just the diagram.

                 Left-aligned, like the issues list. They are capped at 440 and the column is wider than
                 that, so without it a card centred itself in the leftover space — which put the driver
                 block adrift somewhere right of the card explaining which driver is in use, with a gap
                 between them and nothing in it. The comment that used to sit here described a WrapPanel
                 that had already stopped existing. -->

                    <!-- EXTERNAL DAEMON (#591): OTA connects to whatever daemon is already running — including
                         an officially-installed / separately-started OpenTabletDriver — and launches whichever
                         one the search ladder resolves to when nothing is running (docs/design/official-otd-release.md:
                         an installed OTD outranks the dev tree on macOS, so "we started it" no longer implies
                         "it is our build"). When the connected daemon isn't OTA's build, present that here as
                         a supported setup (path + version). The topology already says "External" under the
                         daemon end; this card is where the explanation lives.

                         The way back to the bundled copy lives here, in two states (#725). 660b49a removed
                         the original button as duplication, and it was also capable of lying: it asked only
                         whether a bundled copy existed, so with a chosen location it offered a switch that
                         restarted the daemon the user was trying to leave. The offer is now made only when
                         the restart would reach the bundled copy, and when a chosen location is in front of
                         it the card says so and points at Clear rather than hiding the option. -->
                    <!-- One block for both answers to "which driver?", because they are the same
                         question: install the official release, or open the settings window of the
                         driver that is already answering.
                         They were two sections with two headings and two paragraphs saying so. -->
                    <c:Section MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Top"
                               IsVisible="{Binding ShowDriverCard}">
                        <StackPanel>
                            <TextBlock Classes="Display section" Text="OTD daemon" TextWrapping="Wrap" Margin="0,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button Content="{Binding InstallVersion, StringFormat='Install v{0}'}"
                                        IsVisible="{Binding ShowInstallCard}"
                                        Command="{Binding InstallOtdCommand}"
                                        IsEnabled="{Binding !IsInstalling}"
                                        Theme="{StaticResource AccentButton}" Padding="12,6" />
                            </StackPanel>

                            <!-- Says what pressing Install actually does — where the download comes from and
                                 where it lands. Only shown when Install is on offer. -->
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding ShowInstallCard}"
                                       Text="{Binding InstallDescription}" />

                            <StackPanel Margin="0,8,0,0" IsVisible="{Binding IsInstalling}">
                                <TextBlock Classes="propValue" Text="{Binding InstallStatus}" TextWrapping="Wrap" />
                                <ProgressBar Margin="0,4,0,0" Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding InstallProgress}" />
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding HasInstallProblem}"
                                       Text="{Binding InstallProblem}" />

                            <!-- Unsigned artifact: the user approves it themselves. OTA does not remove the
                                 quarantine attribute for them. -->
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding HasInstallGuidance}"
                                       Text="{Binding InstallGuidance}" />

                        </StackPanel>
                    </c:Section>

                    <!-- Linux only: is OTD installed as a system RPM package (the normal Fedora/RHEL install), or is
                         it running from source / a tarball? Checked on-demand (tab entry + the Refresh button). -->
                    <c:Section MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Top"
                               IsVisible="{Binding IsLinux}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" MinWidth="0">
                                    <TextBlock Classes="Display section" Text="system-installed daemon" TextWrapping="Wrap" Margin="0,0,0,0" />

                                    <!-- property: value list -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"
                                          RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                                        <!-- Package: installed via RPM (+ version) or running from source/tarball -->
                                        <Panel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Classes="propLabel" Text="Package"
                                                       IsVisible="{Binding OtdPackageInstalled}" />
                                            <TextBlock Classes="propLabel" Text="Package"
                                                       IsVisible="{Binding ShowOtdPackageMissing}" />
                                        </Panel>
                                        <Panel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Classes="propValue"
                                                       Text="{Binding OtdPackageVersion, StringFormat='Installed (RPM) — v{0}'}"
                                                       IsVisible="{Binding OtdPackageInstalled}"
                                                       ToolTip.Tip="OpenTabletDriver is installed via your package manager (rpm -q opentabletdriver)" />
                                            <TextBlock Classes="propValue"
                                                       Text="Not installed (running from source / tarball)"
                                                       IsVisible="{Binding ShowOtdPackageMissing}"
                                                       ToolTip.Tip="No 'opentabletdriver' RPM package is installed (rpm -q opentabletdriver)" />
                                        </Panel>

                                        <!-- Packaged daemon binary path -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="propLabel" Text="Path"
                                                   IsVisible="{Binding HasOtdDaemonPath}" />
                                        <c:IconButton Grid.Row="1" Grid.Column="1" Icon="{StaticResource IconFolderOutline}"
                                                      Width="26" Height="22" IconSize="13"
                                                      HorizontalAlignment="Left" Margin="0,2,0,0"
                                                      Command="{Binding OpenContainingFolderCommand}"
                                                      CommandParameter="{Binding OtdDaemonPath}"
                                                      ToolTip.Tip="{Binding OtdDaemonPath}"
                                                      AutomationProperties.Name="Open the folder holding this daemon"
                                                      IsVisible="{Binding HasOtdDaemonPath}" />

                                        <!-- Service running -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="propLabel" Text="Service"
                                                   IsVisible="{Binding OtdServiceActive}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="propValue"
                                                   Text="Running (opentabletdriver.service)"
                                                   IsVisible="{Binding OtdServiceActive}" />
                                    </Grid>

                                    <!-- Start the packaged systemd user service (shown when installed but not running) -->
                                    <Button Content="Start OpenTabletDriver service" Margin="0,10,0,0"
                                            Command="{Binding StartOtdServiceCommand}"
                                            IsVisible="{Binding ShowStartOtdService}"
                                            Theme="{StaticResource AccentButton}" Padding="12,6"
                                            HorizontalAlignment="Left" />

                                    <!-- Result of the last Start action -->
                                    <TextBlock Text="{Binding OtdServiceStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding HasOtdServiceStatus}" />
                                </StackPanel>

                                <!-- Refresh: re-run the package check on demand. -->
                                <c:IconButton Grid.Column="1" Icon="{StaticResource IconRefresh}"
                                              Command="{Binding CheckOtdPackageCommand}"
                                              ToolTip.Tip="Re-check whether OTD is installed as a system package"
                                              AutomationProperties.Name="Re-check system package"
                                              VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                    </c:Section>

            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
